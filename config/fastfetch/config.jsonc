// FreeLFS default fastfetch config (installed as /etc/fastfetch/config.jsonc).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/2.71.0/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/etc/fastfetch/freelfs-braille.txt",
        "color": {
            "1": "#3f9b63"
        },
        "padding": {
            "right": 3
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        {
            "type": "command",
            "key": "Packages",
            "text": "echo \"$(flpkg list 2>/dev/null | wc -l) (flpkg)\""
        },
        "shell",
        "display",
        {
            "type": "custom",
            "key": "DE",
            "format": "flde"
        },
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "colors"
    ]
}
