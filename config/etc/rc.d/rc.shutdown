#!/bin/bash
# /etc/rc.d/rc.shutdown 0|6 -- bring the system down after the services
# have stopped, then power off (0) or reboot (6).

. /etc/rc.conf
. /etc/rc.d/functions

case $HARDWARECLOCK in
	localtime) clock=--localtime ;;
	*) clock=--utc ;;
esac
step "Saving the system clock" timeout 10 hwclock --systohc "$clock"

stat_busy "Stopping remaining processes"
killall5 -15
sleep 2
killall5 -9
stat_done

step "Deactivating swap" timeout 20 swapoff -a
step "Unmounting file systems" timeout 30 umount -a -r -O no_netdev \
	-t notmpfs,nosysfs,noproc,nodevtmpfs,nodevpts,nocgroup2
step "Remounting root read-only" timeout 10 bash -c ". /etc/rc.d/functions; remount_root ro"
timeout 15 sync

if [ "$1" = 6 ]; then
	echo "Rebooting."
	reboot -d -f -i
else
	echo "Powering off."
	halt -d -f -i -p
fi
