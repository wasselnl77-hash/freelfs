# /etc/fstab -- FreeLFS
#
# The root file system is btrfs: subvolume @ (the default one) is /, @home is
# /home, where people's homes are, @snapshots holds snapshots of /. The EFI
# system partition (FAT, label ESP) is /boot, where the kernels live for flboot.
#
# file system   mount point     type      options                      dump pass
LABEL=freelfs   /               btrfs     defaults,noatime,compress=zstd:1 0  0
LABEL=freelfs   /home           btrfs     defaults,noatime,compress=zstd:1,subvol=@home,nofail 0 0
LABEL=freelfs   /.snapshots     btrfs     defaults,noatime,subvol=@snapshots,nofail 0 0
LABEL=ESP       /boot           vfat      defaults,umask=0022,quiet,nofail 0 2
proc            /proc           proc      nosuid,noexec,nodev          0    0
sysfs           /sys            sysfs     nosuid,noexec,nodev          0    0
devpts          /dev/pts        devpts    gid=5,mode=620               0    0
tmpfs           /run            tmpfs     defaults                     0    0
devtmpfs        /dev            devtmpfs  mode=0755,nosuid             0    0
tmpfs           /dev/shm        tmpfs     nosuid,nodev                 0    0
tmpfs           /tmp            tmpfs     nosuid,nodev,mode=1777       0    0
cgroup2         /sys/fs/cgroup  cgroup2   nosuid,noexec,nodev          0    0
