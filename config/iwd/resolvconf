#!/bin/sh
# resolvconf -- just the two calls iwd makes, as /etc/resolv.conf:
#   resolvconf -a NAME   (stdin: "nameserver ADDR" / "search DOMAIN" lines)
#   resolvconf -d NAME
# Lives in /usr/lib/iwd/bin, which only iwd's service has in its PATH, so it
# never answers for dhcpcd. SPDX-License-Identifier: MIT
dir=/run/iwd-resolv
out=/etc/resolv.conf
mark='# generated by iwd (FreeLFS resolvconf helper)'
name=$2
case $name in
	'' | */* | .*) exit 1 ;;
esac
case $1 in
	-a)
		mkdir -p "$dir" || exit 1
		cat > "$dir/$name.new" && mv "$dir/$name.new" "$dir/$name" || exit 1
		;;
	-d)
		rm -f "$dir/$name"
		;;
	*)
		echo "usage: resolvconf -a NAME < config | resolvconf -d NAME" >&2
		exit 1
		;;
esac
if ls "$dir"/* > /dev/null 2>&1; then
	{ echo "$mark"; cat "$dir"/*; } > "$out.new" && mv "$out.new" "$out"
elif [ "$(head -n 1 "$out" 2> /dev/null)" = "$mark" ]; then
	rm -f "$out" # nothing left; a file dhcpcd wrote is not touched
fi
exit 0
