# FreeLFS kernel settings, merged over the architecture's defconfig by
# build/41-kernel.sh. Everything needed to reach the root file system is
# built in: FreeLFS boots without an initramfs.

CONFIG_LOCALVERSION="-freelfs"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="freelfs"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# /dev is devtmpfs, mounted by the kernel before init starts
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FW_LOADER=y
# CONFIG_UEVENT_HELPER is not set

# Root and boot file systems
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# UEFI: flboot (M4) and OVMF boot the kernel through its EFI stub
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# Disks: NVMe, AHCI, virtio
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y

# Disks on USB (booting FreeLFS from a stick: no initramfs, so the whole
# path to the root file system is built in). SCSI disk support is the layer
# USB storage sits on.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y

# Console: serial for QEMU, simpledrm framebuffer until the GPU driver loads
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y

# Set the system clock from the RTC at boot (rc.sysinit relies on it)
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"

# Needed by userland: cgroup v2, namespaces (rootless builds inside FreeLFS),
# zram swap
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_ZRAM=m
CONFIG_PSI=y

# M6: graphics, input, sound and Wi-Fi, for QEMU and for real laptops (the
# development one has an AMD Mendocino GPU and a Realtek RTL8852BE Wi-Fi
# card). These are modules: udev loads them, and they load their firmware
# from /lib/firmware (the linux-firmware package).
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_I915=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# laptop touchpads and keyboards: I2C HID on AMD and Intel
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_HID_ACPI=m
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AMD=y
CONFIG_INPUT_UINPUT=y
# sound: HD audio (laptops, HDMI, QEMU's intel-hda) and USB audio
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_USB_AUDIO=m
# Wi-Fi: Realtek rtw89 (RTL8852BE) and Intel; iwd needs the kernel's crypto
# and key interfaces
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW89=m
CONFIG_RTW89_8852BE=m
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_DES=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# M9: the live ISO. Its own initramfs (src/flinitrd) finds the ISO, or the
# ISO file on a Ventoy stick, and mounts a squashfs from it, so every
# file system on that path is built in.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA_PIIX=y
# a fake Wi-Fi radio for testing iwd and the Settings Wi-Fi page without hardware
CONFIG_MAC80211_HWSIM=m

# Flatpak (M8): bubblewrap needs user, PID, network, IPC and UTS namespaces and
# seccomp filters (all on already: CONFIG_USER_NS above, the rest are the
# defaults under NAMESPACES and SECCOMP in the x86_64/arm64 defconfig). FUSE is
# new: Flatpak's document portal (xdg-document-portal) mounts a FUSE file
# system, and /dev/fuse needs it built in (a module would need loading by
# hand). OverlayFS is on for the live ISO.
CONFIG_FUSE_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y

# E2 gaming. Game controllers, force feedback, the virtual input devices Steam
# Input makes, and what Proton uses. Drivers that need hardware are modules (udev
# loads them by alias when the pad is plugged in); the three that make a device
# node without hardware (uinput, uhid, ntsync) are built in, so /dev/uinput,
# /dev/uhid and /dev/ntsync exist from boot: rc.sysinit loads no modules. The
# udev rules that open them to the seat group are recipes/gaming-config.
# Xbox 360/One/Series pads over USB and the 360 wireless receiver. xpad is
# CONFIG_JOYSTICK_XPAD: the "hid-xpad" name is not in mainline.
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_INPUT_JOYDEV=m
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
# hid-playstation (DualShock 4, DualSense) needs multicolour LEDs for the light bar
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
# Switch Pro Controller, Joy-Con, Nintendo Switch Online pads (USB; Bluetooth
# needs BlueZ, which is later)
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
# Steam Controller and Steam Deck controls without the Steam client; the
# client itself talks to /dev/hidraw. Blacklist hid-steam if it gets in the way.
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y
CONFIG_HIDRAW=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_UHID=y
# Proton: NT synchronisation primitives (Wine's ntsync, kernel 6.14 and later;
# Proton 10 and wine-ntsync use /dev/ntsync, older ones fall back to esync/fsync).
# futex_waitv (fsync) is part of CONFIG_FUTEX, already on; 32-bit programs
# (Steam, Proton's wineserver for 32-bit games) need IA32_EMULATION and
# MODIFY_LDT_SYSCALL, both on in the x86_64 defconfig. User namespaces: on
# above (CONFIG_USER_NS), Steam's pressure-vessel and Flatpak need them.
CONFIG_NTSYNC=y

# Kernel 7.x no longer turns the vendor-specific HID drivers on by default (6.18 did:
# "default !EXPERT"). Laptop keyboards (ITE and Chicony carry the Fn and media keys),
# Logitech/Microsoft/Apple/Cherry keyboards and mice need them, so they are named here and the
# 6.18 (linux-lts) and 7.x kernels have the same set. Same for the old ALSA control API.
CONFIG_HID_A4TECH=y
CONFIG_HID_APPLE=y
CONFIG_HID_BELKIN=y
CONFIG_HID_CHERRY=y
CONFIG_HID_CHICONY=y
CONFIG_HID_CYPRESS=y
CONFIG_HID_EZKEY=y
CONFIG_HID_ITE=y
CONFIG_HID_KENSINGTON=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_MONTEREY=y
CONFIG_HID_REDRAGON=y
CONFIG_SND_SUPPORT_OLD_API=y

# ---- Intel and AMD hardware, about 2015 to now (laptops and desktops) ----
# Prepared from the Kconfig trees only: not tried on real Intel hardware, the AMD parts only
# partly on a Ryzen 5 7520U (see docs/HARDWARE.md). Modules where the device is found by its
# PCI/ACPI/USB id and the root file system does not need it; built in where the installed
# system has no initramfs and the root device or its power/GPIO plumbing needs it.

# CPU frequency and idle: intel_pstate / amd-pstate (active mode = EPP, which flpower writes),
# acpi-cpufreq for CPUs older than that; microcode is loaded early from an initrd (see flboot,
# flucode) and late-loading stays off.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_X86_ACPI_CPUFREQ=m
CONFIG_MICROCODE=y
CONFIG_INTEL_IDLE=y

# Graphics: i915 (above) for Gen 4 up to Alder Lake / DG1, xe for Xe2 and newer (Lunar Lake,
# Battlemage; it takes Tiger Lake and up with xe.force_probe). amdgpu (above) also for the older
# GCN 1 and 2 cards; radeon for TeraScale gives kernel mode setting only (Mesa has no r600 here).
CONFIG_DRM_XE=m
CONFIG_DRM_DISPLAY_DP_AUX_CHARDEV=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_RADEON=m
CONFIG_ACPI_VIDEO=y

# Audio: Intel HDA codecs, SOF on Intel (Apollo/Gemini/Jasper/Elkhart/Tiger/Alder/Meteor/Lunar
# Lake) and AMD (Renoir, ACP6x for Ryzen 6000/7020 U series, ACP 6.3 for Ryzen 7040/8040 and 7640HS).
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_CIRRUS=m
CONFIG_SND_HDA_CODEC_CS8409=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_CODEC_SENARYTECH=m
CONFIG_SND_HDA_CODEC_CA0132=m
CONFIG_SND_HDA_CODEC_VIA=m
CONFIG_SND_HDA_INTEL_HDMI_SILENT_STREAM=y
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_ACPI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_APOLLOLAKE=m
CONFIG_SND_SOC_SOF_GEMINILAKE=m
CONFIG_SND_SOC_SOF_ICELAKE=m
CONFIG_SND_SOC_SOF_JASPERLAKE=m
CONFIG_SND_SOC_SOF_ELKHARTLAKE=m
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_SOC_SOF_AMD_TOPLEVEL=m
CONFIG_SND_SOC_SOF_AMD_RENOIR=m
CONFIG_SND_SOC_SOF_AMD_ACP63=m
CONFIG_SND_SOC_AMD_ACP6x=m
CONFIG_SND_SOC_AMD_YC_MACH=m
CONFIG_SND_SOC_AMD_PS=m
CONFIG_SND_SOC_AMD_PS_MACH=m
CONFIG_SND_SOC_DMIC=m
CONFIG_SPI=y
CONFIG_SOUNDWIRE=m
CONFIG_SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES=y
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=m

# Wi-Fi and Bluetooth: Intel (iwlmvm for 7260 and newer, iwldvm for the 5000/6000 series, iwlmld
# for Wi-Fi 7), Realtek rtw88 and rtw89, MediaTek MT7921/MT7922/MT7925 (the usual AMD laptop chips);
# Bluetooth over USB (btintel, btrtl, btmtk, btbcm) and Intel's PCIe Bluetooth
CONFIG_IWLDVM=m
CONFIG_IWLMLD=m
CONFIG_RTW88=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_AUTOSUSPEND=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_INTEL_PCIE=m
CONFIG_BT_HIDP=m
CONFIG_BT_RFCOMM=m

# Ethernet: Realtek r8169 and USB r8152, Intel e1000e / igb / igc, USB tethering (CDC)
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_R8169=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_REALTEK_PHY=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m

# Storage: Intel VMD hides NVMe drives behind its own PCI domain (many Intel laptops since
# Tiger Lake, "RST" mode); the root device must be visible without an initramfs, so it is built in.
CONFIG_VMD=y
# SD card readers (Realtek PCIe, generic SDHCI)
CONFIG_MMC=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
CONFIG_MISC_RTSX_PCI=m
CONFIG_MMC_REALTEK_PCI=m

# Input and sensors: Intel LPSS (I2C and GPIO behind touchpads and touchscreens), the pin
# controllers of Intel platforms (touchpad interrupts), SMBus touchpads (Synaptics RMI4,
# Elan), Intel ISH and AMD SFH sensor hubs (I2C-HID is above).
CONFIG_X86_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ELKHARTLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_LAKEFIELD=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_I2C_I801=m
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_MOUSE_PS2_SYNAPTICS_SMBUS=y
CONFIG_MOUSE_ELAN_I2C=m
CONFIG_RMI4_CORE=m
CONFIG_RMI4_I2C=m
CONFIG_RMI4_SMB=m
CONFIG_RMI4_F03=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
CONFIG_HID_ASUS=m
CONFIG_HID_LENOVO=m
CONFIG_HID_SENSOR_HUB=m
CONFIG_INTEL_ISH_HID=m
CONFIG_AMD_SFH_HID=m

# Thermal, power and platform: Intel package temperature / powerclamp / RAPL and DPTF thermal
# zones, hwmon temperatures (coretemp, k10temp), AMD s2idle (amd_pmc),
# Intel S0ix (pmc_core), hotkey / platform-profile drivers of the common laptop makers,
# Thunderbolt/USB4 and USB-C (UCSI)
CONFIG_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_INTEL_POWERCLAMP=m
CONFIG_INTEL_RAPL=m
CONFIG_INT340X_THERMAL=m
CONFIG_AMD_PMC=m
CONFIG_INTEL_VSEC=m
CONFIG_INTEL_PMT_TELEMETRY=m
CONFIG_INTEL_PMC_CORE=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m
CONFIG_ACPI_PLATFORM_PROFILE=y
CONFIG_THINKPAD_ACPI=m
CONFIG_IDEAPAD_LAPTOP=m
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_DELL_LAPTOP=m
CONFIG_DELL_WMI=m
CONFIG_HP_WMI=m
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_ACER_WMI=m
CONFIG_USB4=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
