# FreeLFS kernel settings, merged over the architecture's defconfig by
# build/41-kernel.sh. Everything needed to reach the root file system is
# built in: FreeLFS boots without an initramfs.

CONFIG_LOCALVERSION="-freelfs"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="freelfs"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# /dev is devtmpfs, mounted by the kernel before init starts
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FW_LOADER=y
# CONFIG_UEVENT_HELPER is not set

# Root and boot file systems
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# UEFI: flboot (M4) and OVMF boot the kernel through its EFI stub
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# Disks: NVMe, AHCI, virtio
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y

# Disks on USB (booting FreeLFS from a stick: no initramfs, so the whole
# path to the root file system is built in). SCSI disk support is the layer
# USB storage sits on.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y

# Console: serial for QEMU, simpledrm framebuffer until the GPU driver loads
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y

# Set the system clock from the RTC at boot (rc.sysinit relies on it)
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"

# Needed by userland: cgroup v2, namespaces (rootless builds inside FreeLFS),
# zram swap
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_ZRAM=m
CONFIG_PSI=y

# M6: graphics, input, sound and Wi-Fi, for QEMU and for real laptops (the
# development one has an AMD Mendocino GPU and a Realtek RTL8852BE Wi-Fi
# card). These are modules: udev loads them, and they load their firmware
# from /lib/firmware (the linux-firmware package).
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_I915=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# laptop touchpads and keyboards: I2C HID on AMD and Intel
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_HID_ACPI=m
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AMD=y
CONFIG_INPUT_UINPUT=y
# sound: HD audio (laptops, HDMI, QEMU's intel-hda) and USB audio
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_USB_AUDIO=m
# Wi-Fi: Realtek rtw89 (RTL8852BE) and Intel; iwd needs the kernel's crypto
# and key interfaces
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW89=m
CONFIG_RTW89_8852BE=m
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_DES=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# M9: the live ISO. Its own initramfs (src/flinitrd) finds the ISO, or the
# ISO file on a Ventoy stick, and mounts a squashfs from it, so every
# file system on that path is built in.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA_PIIX=y
# a fake Wi-Fi radio for testing iwd and the Settings Wi-Fi page without hardware
CONFIG_MAC80211_HWSIM=m

# Flatpak (M8): bubblewrap needs user, PID, network, IPC and UTS namespaces and
# seccomp filters (all on already: CONFIG_USER_NS above, the rest are the
# defaults under NAMESPACES and SECCOMP in the x86_64/arm64 defconfig). FUSE is
# new: Flatpak's document portal (xdg-document-portal) mounts a FUSE file
# system, and /dev/fuse needs it built in (a module would need loading by
# hand). OverlayFS is on for the live ISO.
CONFIG_FUSE_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y

# E2 gaming. Game controllers, force feedback, the virtual input devices Steam
# Input makes, and what Proton uses. Drivers that need hardware are modules (udev
# loads them by alias when the pad is plugged in); the three that make a device
# node without hardware (uinput, uhid, ntsync) are built in, so /dev/uinput,
# /dev/uhid and /dev/ntsync exist from boot: rc.sysinit loads no modules. The
# udev rules that open them to the seat group are recipes/gaming-config.
# Xbox 360/One/Series pads over USB and the 360 wireless receiver. xpad is
# CONFIG_JOYSTICK_XPAD: the "hid-xpad" name is not in mainline.
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_INPUT_JOYDEV=m
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
# hid-playstation (DualShock 4, DualSense) needs multicolour LEDs for the light bar
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
# Switch Pro Controller, Joy-Con, Nintendo Switch Online pads (USB; Bluetooth
# needs BlueZ, which is later)
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
# Steam Controller and Steam Deck controls without the Steam client; the
# client itself talks to /dev/hidraw. Blacklist hid-steam if it gets in the way.
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y
CONFIG_HIDRAW=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_UHID=y
# Proton: NT synchronisation primitives (Wine's ntsync, kernel 6.14 and later;
# Proton 10 and wine-ntsync use /dev/ntsync, older ones fall back to esync/fsync).
# futex_waitv (fsync) is part of CONFIG_FUTEX, already on; 32-bit programs
# (Steam, Proton's wineserver for 32-bit games) need IA32_EMULATION and
# MODIFY_LDT_SYSCALL, both on in the x86_64 defconfig. User namespaces: on
# above (CONFIG_USER_NS), Steam's pressure-vessel and Flatpak need them.
CONFIG_NTSYNC=y
