# A layout change: /var and /etc become links into sysflfs
pkgname=layout
version=1.0
release=1
summary="Moves /var and /etc into /usr (the layout test: any real directory as target)"
license=(MIT)
arch=(any)
source=()
sha256=()

package() {
	cd "$pkgdir"
	install -d usr/data usr/settings
	ln -s usr/data var
	ln -s usr/settings etc
}
