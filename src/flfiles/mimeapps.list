# FreeLFS default apps. Each person's own choices go in ~/.config/mimeapps.list and win over this file.
[Default Applications]
image/png=flview.desktop;
image/jpeg=flview.desktop;
image/webp=flview.desktop;
application/pdf=flpdf.desktop;
application/epub+zip=flpdf.desktop;
application/x-cbz=flpdf.desktop;
application/oxps=flpdf.desktop;
audio/mpeg=flmusic.desktop;
audio/flac=flmusic.desktop;
audio/ogg=flmusic.desktop;
audio/x-vorbis+ogg=flmusic.desktop;
audio/opus=flmusic.desktop;
audio/mp4=flmusic.desktop;
audio/x-wav=flmusic.desktop;
audio/aac=flmusic.desktop;
audio/x-flac=flmusic.desktop;
audio/x-opus+ogg=flmusic.desktop;
video/mp4=flvideo.desktop;
video/x-matroska=flvideo.desktop;
video/webm=flvideo.desktop;
video/x-msvideo=flvideo.desktop;
video/quicktime=flvideo.desktop;
video/mpeg=flvideo.desktop;
video/ogg=flvideo.desktop;
text/plain=fledit.desktop;
text/x-markdown=fledit.desktop;
text/markdown=fledit.desktop;
application/json=fledit.desktop;
application/x-shellscript=fledit.desktop;
application/zip=flarchive.desktop;
application/x-tar=flarchive.desktop;
application/x-compressed-tar=flarchive.desktop;
application/x-7z-compressed=flarchive.desktop;
application/vnd.rar=flarchive.desktop;
application/x-rar=flarchive.desktop;
application/gzip=flarchive.desktop;
application/x-bzip2=flarchive.desktop;
application/x-xz=flarchive.desktop;
application/zstd=flarchive.desktop;
application/x-zstd-compressed-tar=flarchive.desktop;
text/html=freebws.desktop;
x-scheme-handler/http=freebws.desktop;
x-scheme-handler/https=freebws.desktop;
