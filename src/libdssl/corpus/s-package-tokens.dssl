// =========================================================================
// tokens.dssl - DSSL's own design tokens
// v0.3.3 "The Classic Edition": a print-era look - parchment paper, ink,
// oxblood accent, serif display type, squared corners, hairline rules.
// The dark palette lives in a behavior and is `use`d by both the system
// preference and the manual theme signal - define once, apply twice.
// =========================================================================

tokens {
  font {
    serif: "Charter", "Iowan Old Style", "Palatino Linotype", "Palatino", "Georgia", "Times New Roman", serif
    sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif
    mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace
  }
  color {
    paper: #f5f0e4
    card: #fdfaf2
    ink: #26201a
    muted: #6f6250
    line: #ddd2bc
    accent: #7c2d2d
    accent-ink: #f9efdd
    ok: #3d6b46
    err: #a83226
    code-bg: #ece4cf
    code-ink: #2b2318
    code-line: #d8cbac
    code-key: #8e3b1f
    code-sel: #38614f
    code-prop: #35566e
    code-str: #6f5a22
    code-num: #6e3b52
    code-com: #6f6350
  }
  radius {
    sm: 2
    md: 4
    lg: 6
    xl: 8
    full: 999
  }
  shadow {
    sm: 0 1 2 color.ink/12
    md: 0 2 6 color.ink/14
    lg: 0 6 18 color.ink/16
  }
}

// ---- dark palette (shared) ---------------------------------------------
// classic dark = a candlelit study: deep walnut, parchment text, brass accent

behavior palette-dark {
  tokens {
    font {
      serif: "Charter", "Iowan Old Style", "Palatino Linotype", "Palatino", "Georgia", "Times New Roman", serif
      sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif
      mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace
    }
    color {
      paper: #181310
      card: #221b15
      ink: #ece2cd
      muted: #a5937a
      line: #372d21
      accent: #c98d52
      accent-ink: #241402
      ok: #7fae8a
      err: #d97e6c
      code-bg: #120e0b
      code-ink: #e5d9bd
      code-line: #2e261c
      code-key: #d99a62
      code-sel: #8fb8a2
      code-prop: #92b4cc
      code-str: #c9b47c
      code-num: #c9a0b4
      code-com: #94856a
    }
  }
}

@media (prefers-color-scheme: dark) {
  use palette-dark
}

@signal theme == dark {
  use palette-dark
}

@signal theme == light {
  use palette-light
}

behavior palette-light {
  tokens {
    font {
      serif: "Charter", "Iowan Old Style", "Palatino Linotype", "Palatino", "Georgia", "Times New Roman", serif
      sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif
      mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace
    }
    color {
      paper: #f5f0e4
      card: #fdfaf2
      ink: #26201a
      muted: #6f6250
      line: #ddd2bc
      accent: #7c2d2d
      accent-ink: #f9efdd
      ok: #3d6b46
      err: #a83226
      code-bg: #ece4cf
      code-ink: #2b2318
      code-line: #d8cbac
      code-key: #8e3b1f
      code-sel: #38614f
      code-prop: #35566e
      code-str: #6f5a22
      code-num: #6e3b52
      code-com: #6f6350
    }
  }
}
