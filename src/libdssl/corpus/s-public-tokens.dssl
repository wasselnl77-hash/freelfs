// =========================================================================
// tokens.dssl: the vocabulary the whole site is written in.
//
// The look: cool lilac paper, deep violet ink, one loud accent. The accent is
// a live token. The editor on the home page rewrites it and the whole site
// retints, which is the point of tokens being the vocabulary.
//
// Colour is used with a job each:
//   accent  the one thing you can act on (links, primary buttons, focus)
//   tape    warning-tape yellow, only ever for errors and warnings
//   ok      something worked
// Code always sits on a dark panel, in light and dark mode alike, so a code
// sample reads as "the language" and the page around it reads as "the talk".
// =========================================================================

tokens {
  font {
    sans: var(--font-display), "Helvetica Neue", Arial, system-ui, sans-serif
    serif: var(--font-display), "Helvetica Neue", Arial, system-ui, sans-serif
    mono: var(--font-code), ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace
  }
  color {
    paper: #f2f0f7
    card: #ffffff
    ink: #1a1426
    muted: #5d5570
    line: #dcd7e6
    accent: #d1006f
    accent-ink: #ffffff
    ok: #126a44
    err: #c2261d
    tape: #ffd23f
    tape-ink: #2b2200
    code-bg: #17111f
    code-ink: #ece7f5
    code-line: #2e2540
    code-key: #ff8ac4
    code-sel: #9ce3c0
    code-prop: #a9c6ff
    code-str: #ffd98a
    code-num: #e5a6ff
    code-com: #a79dbf
  }
  radius {
    sm: 4
    md: 8
    lg: 14
    xl: 22
    full: 999
  }
  shadow {
    sm: 0 1 2 color.ink/10
    md: 0 4 14 color.ink/10
    lg: 0 22 60 color.ink/24
  }
}

// ---- dark palette (shared) ---------------------------------------------
// the same hues, turned down: a violet-black page and a code panel a shade
// deeper than it. There is deliberately NO accent in here. One accent works on
// both papers (white text on it is 5.3:1, and it is 3.5:1 or better against
// either page), and keeping it out of the palettes means a tokens block
// elsewhere can change it. Palettes win over later sheets, so anything they set
// cannot be edited live.

behavior palette-dark {
  tokens {
    font {
      sans: var(--font-display), "Helvetica Neue", Arial, system-ui, sans-serif
      serif: var(--font-display), "Helvetica Neue", Arial, system-ui, sans-serif
      mono: var(--font-code), ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace
    }
    color {
      paper: #130f1b
      card: #1c1626
      ink: #efeaf7
      muted: #a79eba
      line: #322a42
      ok: #5fd39a
      err: #ff7a70
      tape: #ffd23f
      tape-ink: #2b2200
      code-bg: #0c0811
      code-ink: #ece7f5
      code-line: #2a2139
      code-key: #ff8ac4
      code-sel: #9ce3c0
      code-prop: #a9c6ff
      code-str: #ffd98a
      code-num: #e5a6ff
      code-com: #a79dbf
    }
  }
}

@media (prefers-color-scheme: dark) {
  use palette-dark
}

@signal theme == dark {
  use palette-dark
}

@signal theme == light {
  use palette-light
}

behavior palette-light {
  tokens {
    font {
      sans: var(--font-display), "Helvetica Neue", Arial, system-ui, sans-serif
      serif: var(--font-display), "Helvetica Neue", Arial, system-ui, sans-serif
      mono: var(--font-code), ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace
    }
    color {
      paper: #f2f0f7
      card: #ffffff
      ink: #1a1426
      muted: #5d5570
      line: #dcd7e6
      ok: #126a44
      err: #c2261d
      tape: #ffd23f
      tape-ink: #2b2200
      code-bg: #17111f
      code-ink: #ece7f5
      code-line: #2e2540
      code-key: #ff8ac4
      code-sel: #9ce3c0
      code-prop: #a9c6ff
      code-str: #ffd98a
      code-num: #e5a6ff
      code-com: #a79dbf
    }
  }
}
