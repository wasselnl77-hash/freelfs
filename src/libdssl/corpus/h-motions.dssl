motion rise-in {
  from { opacity: 0; translate: 0 18 }
  to   { opacity: 1; translate: 0 0 }
}
motion pulse {
  essential
  0%   { opacity: 1 }
  50%  { opacity: 0.6 }
  100% { opacity: 1 }
}
motion multi { 0%, 100% { color: red } at 40% { color: blue } 30 { color: green } }
motion bad { color: red; 120% { color: red } wat { color: red } from { --x: 1; background-color: red; -webkit-text-fill-color: blue } }
motion e1 { essential: true }
motion e2 { essential: false }
motion deform { from { bend: 0 } to { bend: 20; fold: 10; stretch: 1.5 vertical; transform: rotate(3) } }
motion deform2 { to { bend-up: 12; bend-y: 3 } }
motion empty { }
.a { animate: rise-in 400 }

