// =========================================================================
// docs.dssl, language reference layout (also used by the spec view)
// =========================================================================

.page-head {
  padding: space.7 0 space.4
}

.page-title {
  font-size: fluid 34 56
  font-weight: 760
  line-height: 1.04
  letter-spacing: -0.032em
  margin: 0 0 space.3
  font-variation-settings: "wdth" 88
  text-wrap: balance
}

.page-sub {
  color: color.muted
  font-size: 19
  line-height: 1.6
  max-width: 660
  margin: 0
}

.docs-layout {
  display: grid
  grid-template-columns: 236 minmax(0, 1fr)
  gap: fluid 24 64
  align-items: start
  padding-bottom: space.7
}

.docs-side {
  position: sticky
  top: 88
  column: gap 1
  max-height: calc(100vh - 110)
  overflow-y: auto
  padding-right: 6
  scrollbar-width: thin
}

// v0.3.3 fix: this block MUST come after the .docs-side rule above:
// `column:` expands to display:flex, and "later wins" in the cascade,
// so an earlier display:none silently loses (same gotcha as the mobile
// nav sheet in v0.3.0). Here it lives after, so the sidebar actually
// disappears on small screens instead of pinning over the body text.
@media (width <= 920) {
  .docs-layout {
    grid-template-columns: 1fr
  }
  .docs-side {
    display: none
  }
}

.side-head {
  font-size: 14
  font-weight: 700
  color: color.ink
  padding: 0 12
  margin: space.5 0 6
}

.side-head:first-child {
  margin-top: 0
}

.docs-side a {
  padding: 6 12
  radius: 0
  font-size: 14.5
  color: color.muted
  transition: 130
  border-left: 2 solid color.line
  line-height: 1.4
}

.docs-side a:hover {
  color: color.ink
  border-left-color: color.accent
}

.docs-body {
  min-width: 0
  column: gap space.7
}

.doc-block {
  column: gap space.3
  scroll-margin-top: 92
}

.doc-lead {
  color: color.muted
  font-size: 17
  line-height: 1.7
  margin: 0
  max-width: 720
}

// live example well
.demo-box {
  display: grid
  place: center
  gap: 12
  border: 1 dashed color.line
  radius: md
  padding: space.5
  background:
    radial-gradient(color.line/45 1, transparent 1)
  background-size: 16 16
  min-height: 96
}

// tables (semantic property reference, spec votes, …)
// v0.5, display: block + fit-content + internal scroll: the raw table's
// min-content width (705px) used to push the whole page past 360px viewports
//, the last un-swept overflow on this page. Same rules, now owned by the
// stylesheet that actually styles the table, so last-word-wins stays honest.
.tbl {
  display: block
  width: fit-content
  max-width: 100%
  overflow-x: auto
  border-collapse: collapse
  font-size: 13.5
}

.tbl th {
  text-align: left
  padding: 9 12
  border-bottom: 2 solid color.ink
  font-size: 14
  font-weight: 700
  color: color.ink
}

.tbl td {
  padding: 10 12
  border-bottom: 1 solid color.line
  vertical-align: top
  line-height: 1.55
  color: color.ink/90
}

.tbl tr:hover td {
  background: color.ink/4
}

.tbl code {
  font-family: font.mono
  font-size: 12.5
  color: color.ink
  background: color.ink/8
  padding: 1 6
  radius: sm
  white-space: nowrap
}

.tbl-note {
  font-size: 12.5
  color: color.muted
  margin: 8 0 0
}

// callouts
.note {
  border-left: 3 solid color.accent
  background: color.ink/5
  radius: 0 md md 0
  padding: space.3 space.4
  font-size: 14
  line-height: 1.65
  color: color.ink/90
}

.note-warn {
  border-left-color: color.tape
  background: color.tape/22
}

.note b {
  font-weight: 700
}

// docs live-demo widgets
.doc-btn {
  padding: 10 18
  radius: sm
  background: color.card
  border: 1 solid color.ink/45
  font-weight: 600
  font-size: 14
  cursor: pointer
  transition: 150
  color: color.ink
}

.doc-btn:hover {
  border-color: color.accent/50
  background: color.card
  shadow: sm
}

.doc-card {
  width: 250
  padding: space.4
  radius: md
  background: color.card
  border: 1 solid color.line
  shadow: sm
  transition: 200
  column: gap 8
  font-size: 13.5
}

.doc-card:hover {
  shadow: md
  border-color: color.ink/38
}

.doc-card-title {
  font-weight: 700
  font-size: 14.5
}

.doc-card-sub {
  color: color.muted
  font-size: 12.5
  line-height: 1.5
}

.motion-box {
  padding: space.4 space.5
  radius: md
  background: color.code-bg
  color: color.code-ink
  font-family: font.mono
  font-size: 13.5
  min-width: 220
  text-align: center
}

.signal-box {
  padding: space.4 space.5
  radius: md
  border: 1 solid color.line
  background: color.card
  font-size: 14
  font-weight: 600
  transition: 250
  color: color.muted
}

@signal docdemo == hot {
  .signal-box {
    background: color.accent
    border-color: color.accent
    color: color.accent-ink
    shadow: md
  }
}

.tok-demo {
  row: gap 10 center
}

.tok-dot {
  display: inline-grid
  size: 34
  circle: 34
  center: both
  font-family: font.mono
  font-size: 11
  border: 1 solid color.line
  background: color.card
  color: color.muted
  transition: 200
  cursor: pointer
}

.tok-dot:hover {
  shadow: sm
  border-color: color.accent/40
  color: color.accent
}

.scale-bar {
  row: gap 6
  align-items: flex-end
}

.scale-step {
  width: 34
  background: color.accent/70
  radius: 4 4 0 0
  transition: 150
}

.scale-step:hover {
  background: color.accent
}

// motion demo, replayed via DSSL.replay()
motion pop {
  from {
    opacity: 0
    translate: 0 16
    scale: 0.9
  }
}

.motion-box {
  animate: pop 500 snap
}

// fluid type demo
.fluid-demo {
  fluid: 20, 44
  font-weight: 800
  letter-spacing: -0.02em
  line-height: 1.15
  text-align: center
}

.fine-print {
  font-size: 13
}

// =========================================================================
// cheat sheet (v0.3), one-page quick reference
// =========================================================================

.cheat-grid {
  display: grid
  grid-template-columns: 1fr 1fr
  gap: space.4
  padding-bottom: space.7
  align-items: start
}

.cheat-wide {
  grid-column: 1 / -1
}

@media (width <= 860) {
  .cheat-grid {
    grid-template-columns: 1fr
  }
}

.cheat-card {
  border-top: 2 solid color.ink
  padding: space.3 0 0
  column: gap 10
  min-width: 0
}

.cheat-card h3 {
  font-size: 15
  font-weight: 700
  margin: 0
}

.cheat-k {
  font-size: 12.5
  font-weight: 700
  color: color.accent-ink
  background: color.accent
  padding: 2 8
  radius: sm
  align-self: start
}

.cheat-p {
  font-size: 13
  color: color.muted
  line-height: 1.6
  margin: 0
}

.cheat-p code {
  font-family: font.mono
  font-size: 12
  color: color.ink
  background: color.ink/8
  padding: 1 5
  radius: sm
}

.cheat-p a {
  color: color.ink
  font-weight: 600
  text-decoration: underline
  text-decoration-color: color.accent
  text-decoration-thickness: 2
  text-underline-offset: 3
}

.cheat-list {
  column: gap 7
}

.cheat-list .cr {
  row: gap 10
  align-items: baseline
}

.cheat-list code {
  font-family: font.mono
  font-size: 12.5
  color: color.ink
  background: color.ink/8
  padding: 1 6
  radius: sm
  white-space: nowrap
}

.cheat-list span {
  color: color.muted
  font-size: 13
  line-height: 1.5
}

// ---------------------------------------------------- v0.4.0 · power tools

// scoped tokens live demo, inside this box, --color.accent re-declares the
// accent token as color.ok. The tok-dots run the same rules as the palette
// demo above, but the var() references inherit our override, so they go green.
.tok-scope {
  --color.accent: color.ok
  padding: space.4
  border: 1 dashed color.line
  radius: md
  background: color.card
  column: gap 10
}

// seen + stagger live demo, four cards that cascade in when you scroll here
motion rise-in {
  from {
    opacity: 0
    translate: 0 14
  }
}

.pt-grid {
  display: grid
  grid-template-columns: repeat(4, 1fr)
  gap: space.3
  stagger: 70
}

@media (width <= 920) {
  .pt-grid {
    grid-template-columns: repeat(2, 1fr)
  }
}

@media (width <= 560) {
  .pt-grid {
    grid-template-columns: 1fr
  }
}

.pt-card {
  padding: space.4 space.3
  radius: md
  background: color.card
  border: 1 solid color.line
  column: gap 6
  seen {
    animate: rise-in 420 snap
  }
}

.pt-num {
  font-family: font.mono
  font-size: 18
  font-weight: 700
  color: color.ink
}

.pt-card span:last-child {
  font-family: font.mono
  font-size: 12.5
  color: color.muted
}

// =========================================================================
// v0.5, the pseudo-elements section's live demo. The rules below are
// written in the FULL-SELECTOR form (.pe-tag::before), the spelling that
// used to compile ok and then match nothing. The demo renders right only
// if the trap stays closed. The dot is also the site's first `infinite`
// animation, so v0.5 dogfoods both headline features at once.
// =========================================================================

motion pe-pulse {
  from { opacity: 1 }
  to { opacity: 0.2 }
}

.pe-demo {
  row: gap 12 center wrap
  padding: space.4 space.5
  background: color.card
  border: 1 solid color.line
  radius: sm
}

.pe-tag {
  font: 13 color.muted
}

.pe-tag::before {
  content: ""
  display: inline-block
  size: 10
  background: color.accent
  radius: 3
  margin-inline-end: 8
}

.pe-dot {
  size: 12
  radius: full
  background: color.accent
  animate: pe-pulse 1200 infinite alternate
}

.pe-tail {
  font: 12 color.muted
  font-style: italic
}

// =========================================================================
// v0.5, the overlap section's live demo. The ghost is a real 45%-opacity
// element; the site-wide `body { overlap: auto }` policy shoves it out of
// the card after layout. The toggle grants the ghost its own
// `overlap: allow`, the same opt-out a scrim or translucent nav uses.
// The ghost's transition sits on the translate channel, the same channel
// the engine's nudge writes, so the escape glides instead of teleporting.
// =========================================================================

.ov-stage {
  position: relative
  width: 100%
  min-height: 250
}

.ov-card {
  width: min(430, 74%)
  display: grid
  gap: 8
  padding: space.4
  background: color.card
  border: 1 solid color.line
  radius: md
  shadow: sm
}

.ov-card-title {
  font-weight: 700
  font-size: 14
}

.ov-card-sub {
  font: 12.5 color.muted
  line-height: 1.5
}

.ov-ghost {
  position: absolute
  left: 30%
  top: 30%
  padding: 5 11
  radius: 999
  background: color.accent/30
  border: 1 solid color.accent
  color: color.ink
  font: 11.5 font.mono
  white-space: nowrap
  opacity: 0.45
  transition: 340 snap translate
}

// the documented opt-out: the ghost's own policy beats the body's
.ov-stage[data-ov-off] .ov-ghost {
  overlap: allow
}

// =========================================================================
// v0.6.0, the deform section's live demos. The button genuinely flexes
// under the pointer (:active bend + stretch riding the transform channel),
// the chip row is a real bend-around container re-laid on resize, and the
// two mini cards bend-up / fold on hover with edge pivots baked into the
// transform. One transform string carries all of it.
// =========================================================================

.df-row {
  row: gap 14 center wrap
}

.df-btn {
  padding: 12 22
  radius: md
  background: color.accent
  color: color.accent-ink
  font-weight: 700
  font-size: 14
  cursor: pointer
  border: 0
  shadow: sm
  transition: 200 snap transform
  hover {
    bend: 5
    shadow: md
  }
  active {
    bend: 16
    stretch: 0.94
  }
}

.df-mini {
  width: 128
  padding: 14
  display: grid
  place: center
  background: color.card
  border: 1 solid color.line
  radius: md
  font: 12.5 color.muted
  font-family: font.mono
  text-align: center
  transition: 260 snap transform
}

.df-up { hover { bend-up: 14 } }

.df-fold { hover { fold: 14 } }

// narrow screens scroll the arc horizontally instead of stretching the page
// (max-width tames the grid-item minimum size, overflow-x does the scrolling)
.df-arc {
  row: gap 20 center
  padding: 28 space.5 space.4
  background: color.card
  border: 1 solid color.line
  radius: sm
  bend-around: -22
  max-width: 100%
  overflow-x: auto
}

.df-chip {
  padding: 6 14
  radius: full
  background: color.ink/6
  border: 1 solid color.line
  font: 12.5 font.mono color.muted
}

// =========================================================================
// v0.6.0, the gradient section's live demos. The banner flows forever
// (gradient-flow loops background-position through WAAPI and sizes the
// background to 200% itself), the headline clips a gradient into the
// glyphs, and the swatches are the three kinds, one line each.
// =========================================================================

.gd-banner {
  padding: space.5
  radius: md
  gradient: linear 120, color.accent -> color.ok -> color.accent
  gradient-flow: 7s alternate
  color: white
  font-weight: 700
  font-size: 15
  shadow: sm
}

.gd-headline {
  gradient-text: linear to right, color.accent, color.ink
  font-size: 26
  font-weight: 800
  letter-spacing: -0.5
}

.gd-sw-row {
  row: gap 14 wrap
}

.gd-sw {
  size: 72
  radius: md
  border: 1 solid color.line
  shadow: sm
}

.gd-lin { gradient: linear 135, color.accent -> color.ok }

.gd-rad { gradient: radial circle at 30% 20%, color.card -> color.ink }

.gd-con { gradient: conic from 45, color.accent, color.line, color.card, color.accent }

// v0.7, performance chapter sub-heads (dssl-ready / freeze / explain)
.doc-h3 {
  font-weight: 650
  font-size: 18
  letter-spacing: -0.01em
  margin: space.4 0 space.1
  scroll-margin-top: 92
}

// =========================================================================
// v0.9.0: texture, aura and slider demos
// =========================================================================

.tx-wall {
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(104px, 1fr))
  gap: 12
  justify-self: stretch
}

// a demo box whose content should span the whole box instead of sitting centred
.demo-box.wide { display: grid; justify-content: stretch }

.tx-cell {
  column: gap 6
  font-size: 13
}

.tx {
  height: 64
  radius: md
  background-color: #b8a58a
  border: 1 solid color.line
}

// the swatch for each preset is the preset, written as DSSL. This block is generated.
