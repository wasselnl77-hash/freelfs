// =========================================================================
// site.dssl: the chrome shared by every page of the DSSL site
//
// Rules of the house for this stylesheet:
//   one family for people (font.sans), one for code (font.mono)
//   left aligned, one column of reading, no stack of identical cards
//   radius follows size: 4 on tags, 8 on controls, 14 on big panels
//   shadow only where something floats (the live editor), nowhere else
// =========================================================================

html {
  font-family: font.sans
  -webkit-font-smoothing: antialiased
  scroll-behavior: smooth
  font-optical-sizing: auto
}

body {
  background: color.paper
  color: color.ink
  font-size: 17
  line-height: 1.6
  // nothing below 100% opacity may overlap anything; overlays opt out
  // with `overlap: allow`
  overlap: auto
}

::selection {
  background: color.accent/25
}

// accessibility: one behavior, used everywhere
behavior focus-ring {
  focus-visible {
    outline: 3 solid color.accent
    outline-offset: 2
    radius: 4
  }
}

a { use focus-ring }
button { use focus-ring }
input { use focus-ring }
textarea { use focus-ring }
select { use focus-ring }
[tabindex] { use focus-ring }

a {
  color: inherit
}

.skip-link {
  position: absolute
  left: 16
  top: -80
  z: 100
  padding: 10 16
  background: color.ink
  color: color.paper
  radius: md
  font-weight: 600
  transition: 120 top
  focus { top: 12 }
}

// ---------------------------------------------------------------- layout

.site {
  min-height: 100vh
  display: flex
  flex-direction: column
}

.wrap {
  width: 100%
  max-width: 1200
  margin: 0 auto
  padding: 0 space.5
}

.main {
  flex: 1
}

// ------------------------------------------------------------------ nav

.nav {
  position: sticky
  top: 0
  z: 50
  background: color.paper
  border-bottom: 1 solid color.line
}

.nav-inner {
  row: gap space.5 between
  height: 60
  align: center
}

.nav-logo {
  row: gap 2 center
  font-weight: 800
  font-size: 22
  letter-spacing: -0.02em
  color: color.ink
}

.logo-mark {
  color: color.accent
  font-weight: 500
  font-size: 24
  margin-right: 6
  transition: 220 color
}

.nav-links {
  row: gap 2 center
  margin-right: auto
  margin-left: space.5
}

.nav-link {
  padding: 8 12
  color: color.muted
  font-size: 15
  font-weight: 500
  border-bottom: 2 solid transparent
  radius: 0
}

.nav-link:hover {
  color: color.ink
}

// the page you are on: ink text and an accent underline. The attribute is set
// by the router, so no stylesheet has to know which pages exist.
.nav-link[aria-current="page"] {
  color: color.ink
  border-bottom-color: color.accent
}

.nav-side {
  row: gap 10 center
}

.theme-btn {
  size: 36
  // auto (system) mode shows the sun and moon as a pair, light and dark show
  // one icon, so the box is an explicit flex row
  row: center gap 2
  color: color.muted
  border: 1 solid color.line
  radius: md
  cursor: pointer
}

.theme-btn:hover {
  color: color.ink
  border-color: color.ink/40
}

// icon switching driven by an html attribute. The engine re-styles on
// attribute mutations, so the toggle needs zero style code in JS.
html[data-theme-mode="dark"] .icon-sun { display: none }
html[data-theme-mode="light"] .icon-moon { display: none }
html:not([data-theme-mode="dark"]):not([data-theme-mode="light"]) .theme-btn {
  border-style: dashed
}

.ver-badge {
  font-family: font.mono
  font-size: 12.5
  color: color.muted
  padding: 4 2
}

.ver-badge:hover {
  color: color.ink
}

.nav-toggle { display: none }

@media (width <= 860) {
  .nav-toggle {
    display: grid
    place: center
    size: 36
    radius: md
    color: color.muted
    border: 1 solid color.line
    transition: 130
    cursor: pointer
  }
  .nav-toggle:hover { color: color.ink; border-color: color.ink/40 }

  .nav-links {
    position: absolute
    top: 60
    left: 0
    right: 0
    margin: 0
    column: gap 2
    padding: space.3 space.5 space.4
    background: color.paper
    border-bottom: 1 solid color.line
    // last word wins: `column:` above expands to display:flex, so
    // display:none has to come AFTER it to keep the sheet closed
    display: none
  }

  .nav-link {
    padding: 12 0
    font-size: 17
  }

  @signal nav == open {
    .nav-links { display: flex }
  }
}

// ---------------------------------------------------------------- buttons

.btn {
  row: gap 8 center
  padding: 12 22
  radius: md
  font-weight: 600
  font-size: 16
  transition: 150 translate
  cursor: pointer
  border: 1 solid transparent
  user-select: none
  line-height: 1.2
}

.btn-primary {
  background: color.accent
  color: color.accent-ink
}

.btn-primary:hover {
  filter: brightness(1.1)
  translate: 0 -1
}

.btn-primary:active {
  filter: brightness(0.94)
  translate: 0 0
  transition: 60
}

.btn-ghost {
  border-color: color.ink/30
  color: color.ink
  background: transparent
}

.btn-ghost:hover {
  border-color: color.ink
}

.btn-sm {
  padding: 8 14
  font-size: 14
}

// ------------------------------------------------------------ small parts

// legacy panel, still used by a few reference pages
.card {
  background: color.card
  border: 1 solid color.line
  radius: lg
}

// The small label that used to sit above every heading. The headings say
// enough on their own, so it is gone from the markup and hidden here for any
// page that still carries one.
.kicker {
  display: none
}

.section {
  padding: space.8 0
}

.section-title {
  font-size: fluid 28 40
  font-weight: 700
  letter-spacing: -0.025em
  line-height: 1.12
  margin: 0 0 space.3
  font-variation-settings: "wdth" 92
}

.section-sub {
  color: color.muted
  font-size: 18
  line-height: 1.65
  max-width: 640
  margin: 0
}

// -------------------------------------------------------------- code block

.code {
  background: color.code-bg
  color: color.code-ink
  radius: lg
  padding: 18 22
  font-family: font.mono
  font-size: 13.5
  line-height: 1.75
  overflow-x: auto
  tab-size: 2
  margin: 0
}

.code code {
  font-family: font.mono
}

.code-head {
  row: gap 8 between
  align: center
  padding: 8 12 8 22
  background: color.code-line
  color: color.code-com
  radius: lg lg 0 0
  font-family: font.mono
  font-size: 12.5
}

.code-head + .code {
  radius: 0 0 lg lg
}

.code-plain {
  radius: lg
}

.copy-btn {
  color: color.code-ink/80
  font-size: 12
  row: gap 6 center
  padding: 5 10
  radius: md
  border: 1 solid color.code-com/50
  transition: 130
  cursor: pointer
  font-family: font.mono
}

.copy-btn:hover {
  color: color.code-key
  border-color: color.code-key
}

// syntax colours (spans produced by the site's tiny highlighter)
.tok-com { color: color.code-com; font-style: italic }
.tok-sel { color: color.code-sel }
.tok-prop { color: color.code-prop }
.tok-at { color: color.code-key; font-weight: 600 }
.tok-state { color: color.code-key }
.tok-num { color: color.code-num }
.tok-str { color: color.code-str }
.tok-val { color: color.code-ink }
.tok-punct { color: color.code-com }
.tok-use { color: color.code-num }

// ------------------------------------------------------------------ prose

.prose {
  max-width: 700
}

.prose p {
  margin: 0 0 space.4
  line-height: 1.7
  color: color.ink
  font-size: 17
}

.prose p:last-child { margin-bottom: 0 }

.prose h2 {
  font-size: 30
  font-weight: 700
  letter-spacing: -0.02em
  line-height: 1.15
  margin: space.7 0 space.3
  scroll-margin-top: 84
  font-variation-settings: "wdth" 92
}

.prose h3 {
  font-size: 20
  font-weight: 650
  margin: space.5 0 space.2
  scroll-margin-top: 84
}

.prose ul {
  margin: 0 0 space.4
  column: gap 8
  padding: 0
}

// a small square in the accent, so the marker retints with the page
.prose li {
  padding-left: 20
  position: relative
  line-height: 1.65
  color: color.ink
  font-size: 17
}

.prose li::before {
  content: ""
  position: absolute
  left: 2
  top: 0.62em
  size: 7
  background: color.accent
  radius: 1
}

.prose strong {
  font-weight: 700
  color: color.ink
}

.prose a {
  color: color.ink
  text-decoration: underline
  text-decoration-color: color.accent
  text-decoration-thickness: 2
  text-underline-offset: 3
}

// inline code reads as code, not as a link: ink on a faint wash
.prose code,
.doc-lead code,
.section-sub code,
.cheat-p code,
.note code {
  font-family: font.mono
  font-size: 0.86em
  background: color.ink/8
  color: color.ink
  padding: 1 6
  radius: sm
}

.prose .code code {
  background: transparent
  color: inherit
  padding: 0
}

.inline-tag {
  font-family: font.mono
  font-size: 12
  background: color.ink/8
  color: color.ink
  padding: 2 8
  radius: sm
}

// ----------------------------------------------------------------- footer

.footer {
  margin-top: space.8
  border-top: 1 solid color.line
  padding: space.6 0 space.6
}

.footer-inner {
  row: gap space.6 between
  align-items: flex-start
}

@media (width <= 760) {
  .footer-inner {
    display: grid
    gap: space.5
  }
}

.footer-col {
  column: gap space.3
  max-width: 560
}

.footer-note {
  color: color.ink
  font-size: 15
  line-height: 1.65
  margin: 0
}

.footer-fine {
  color: color.muted
  font-size: 14
  line-height: 1.6
  margin: 0
}

.footer-fine a {
  color: color.ink
  text-decoration: underline
  text-decoration-color: color.accent
  text-decoration-thickness: 2
  text-underline-offset: 3
}

.footer-links {
  row: gap 4 wrap
  max-width: 340
}

.footer-links .nav-link {
  padding: 4 10 4 0
  font-size: 15
}

// ------------------------------------------------------- scrollbars
// Native scrollbars are pseudo-elements, so they ride the shadow-CSS
// exception (the parser knows the vendor names).

::-webkit-scrollbar {
  width: 12
  height: 12
}

::-webkit-scrollbar-track {
  background: color.paper
}

::-webkit-scrollbar-thumb {
  background: color.ink/25
  border: 3 solid transparent
  radius: 999
  background-clip: padding-box
}

::-webkit-scrollbar-thumb:hover {
  background: color.ink/45
}

::-webkit-scrollbar-corner {
  background: transparent
}

// ------------------------------------------------------- range sliders
// No slider on this site is the browser's own. This is the default for every
// input[type=range], written with the language's own slider: property. Later
// rules (the home, docs and playground demos) replace it. It is wrapped in :where()
// because the slider parts are real CSS pseudo-elements, which obey specificity,
// and a default has to lose to anything more specific.

:where(input[type=range]) {
  width: 100%
  slider: track 6 color.ink/18 radius full, fill color.accent, thumb 20 color.accent, ring 3 color.card
  focus-visible { outline: 2 solid color.accent; outline-offset: 6 }
}

// -------------------------------------------------------------- utilities

@layer utilities {
  .visually-hidden {
    position: absolute
    width: 1
    height: 1
    overflow: hidden
    clip-path: inset(50%)
    white-space: nowrap
  }
  .mt-0 { margin-top: 0 }
}
