# Commands for build/vm-run.py (see build/m10-features.sh): the account "tester" without a password,
# the sample files from the second disk (build/m10-samples.py), the helpers m10sh and m10app, two
# autostart entries, then the login screen again. Throwaway image copy (-snapshot).
{ id tester >/dev/null 2>&1 || useradd -m tester; } && passwd -d tester >/dev/null && echo made && id tester
mkdir -p /usr/tester/.config/freelfs && printf 'keyboard=us\n' > /usr/tester/.config/freelfs/desktop.conf && chown -R tester: /usr/tester/.config
printf 'LAYOUT=us\n' > /etc/keyboard.conf
mkdir -p /mnt/m10 && mount -o ro /dev/vdb /mnt/m10 && echo mounted && ls /mnt/m10
mkdir -p /usr/tester/m10 && cp /mnt/m10/sample* /mnt/m10/project.zip /mnt/m10/notes.txt /mnt/m10/script.sh /usr/tester/m10/ && cp /mnt/m10/m10app.sh /usr/bin/m10app && cp /mnt/m10/m10sh.sh /usr/bin/m10sh && chmod 755 /usr/bin/m10app /usr/bin/m10sh && chown -R tester: /usr/tester/m10 && umount /mnt/m10 && echo samples-copied
# autostart: a system entry that must run, a system entry the user switched off (a user file of the same name with Hidden=true)
mkdir -p /etc/xdg/autostart /usr/tester/.config/autostart && printf '[Desktop Entry]\nType=Application\nName=M10 on\nExec=sh -c "echo ran > /tmp/m10-autostart"\n' > /etc/xdg/autostart/m10-on.desktop && printf '[Desktop Entry]\nType=Application\nName=M10 off\nExec=sh -c "echo ran > /tmp/m10-off"\n' > /etc/xdg/autostart/m10-off.desktop && printf '[Desktop Entry]\nName=M10 off\nExec=true\nHidden=true\nX-FreeLFS-Override=true\n' > /usr/tester/.config/autostart/m10-off.desktop && chown -R tester: /usr/tester/.config && echo autostart-set
echo "== versions"; uname -r; flpkg list | grep -E "^(flcomp|flpanel|flui|flview|flfiles|flstore|flsnap|flboot|linux) "
echo "== btrfs layout"; grep -E ' / | /usr | /boot | /.snapshots ' /proc/mounts; btrfs subvolume list / | cat
echo "== gaming (kernel 6, gaming-config)"; ls -l /dev/uinput /dev/uhid /dev/ntsync 2>&1; sysctl vm.max_map_count; grep -E "^CONFIG_(JOYSTICK_XPAD|HID_PLAYSTATION|HID_NINTENDO|HID_STEAM|INPUT_UINPUT|UHID|NTSYNC)=" /boot/config-* 2>&1; ls /lib/modules/*/kernel/drivers/hid/ 2>&1 | grep -E "playstation|nintendo|steam"; m10sh 'flgaming check' 2>&1 | head -14
sleep 3; pkill -x flcomp; sleep 6; pgrep -x flgreet-ui >/dev/null && echo greeter-again
free -m | head -2
