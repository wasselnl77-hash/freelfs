# Commands for build/m12-sandbox.sh: an account "tester" without a password (US layout), the helper sbxcheck, then
# the login screen again. Throwaway image copy (-snapshot).
{ id tester >/dev/null 2>&1 || useradd -m tester; } && passwd -d tester >/dev/null && echo made && id tester
mkdir -p /usr/tester/.config/freelfs && printf 'keyboard=us\n' > /usr/tester/.config/freelfs/desktop.conf && chown -R tester: /usr/tester/.config
printf 'LAYOUT=us\n' > /etc/keyboard.conf
# sbxcheck: where the web process runs (INTEGRATION-TODO, sandbox steps 3 and 4)
printf '%s\n' '#!/bin/sh' 'echo "== $1"' 'ps -eo pid,ppid,user,args | grep -E "bwrap|WPEWebProcess|WPENetworkProce|freebws" | grep -v grep | cut -c1-170' 'P=""; for p in $(pgrep WPEWebProcess); do [ "$(cat /proc/$p/comm)" = WPEWebProcess ] && P=$p; done' 'N=$(pgrep WPENetworkProce | head -n 1)' 'echo "web process pid=$P parent=$(ps -o comm= -p $(ps -o ppid= -p $P 2>/dev/null) 2>/dev/null)"' 'grep -E "^(Seccomp|NoNewPrivs):" /proc/$P/status' 'for n in mnt pid user ipc uts; do a=$(readlink /proc/$P/ns/$n); b=$(readlink /proc/self/ns/$n); [ "$a" = "$b" ] && echo "ns $n SAME" || echo "ns $n differs"; done' 'echo "root of the web process: $(ls /proc/$P/root/ | tr "\n" " ")"' 'echo "home visible: $(ls -d /proc/$P/root/usr/tester /proc/$P/root/home/tester /proc/$P/root/root 2>&1 | sed "s/.*cannot access.*/no/" | tr "\n" " ")"' 'echo "etc/passwd readable: $(head -c 20 /proc/$P/root/etc/passwd | head -n 1); write test: $(touch /proc/$P/root/etc/x 2>&1 | cut -c1-60)"' 'echo "dri: $(ls /proc/$P/root/dev/dri 2>&1 | tr "\n" " ")"' 'echo "network process pid=$N parent=$(ps -o comm= -p $(ps -o ppid= -p $N) 2>/dev/null) $(grep -E "^Seccomp:" /proc/$N/status)"' 'dmesg | grep -ci "seccomp\|audit.*syscall" ' > /usr/bin/sbxcheck && chmod 755 /usr/bin/sbxcheck && echo sbxcheck
echo "== versions"; flpkg list | grep -E "^(wpewebkit|freebws|glib|libsoup|libxml2|brotli|openssl|bubblewrap|xdg-dbus-proxy|libseccomp|linux) "; uname -r
echo "== grep bubblewrap strings: $(grep -a -c bubblewrap /usr/lib/libWPEWebKit-2.0.so.1)"; strings -a /usr/lib/libWPEWebKit-2.0.so.1 | grep -E '^/usr/bin/(bwrap|xdg-dbus-proxy)$' | sort -u
echo "== step 1: sandbox-check as the user"; su -s /bin/sh tester -c 'freebws --sandbox-check; echo rc=$?'
sleep 3; pkill -x flcomp; sleep 6; pgrep -x flgreet-ui >/dev/null && echo greeter-again
