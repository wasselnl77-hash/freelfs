# login screen: Ctrl+Alt+T must open nothing
@wait 1
for i in $(seq 60); do pgrep -x flgreet-ui >/dev/null && break; sleep 1; done; pgrep -x flgreet-ui >/dev/null && echo greeter-up
@wait 4
@key ctrl-alt-t
@key meta_l-t
@key meta_l-e
@wait 3
pgrep -a 'flterm|flfiles|general-manager' ; echo "terminals-after-keys: $(pgrep -c -x 'flterm|flfiles' )"
ps -eo pid,user,comm | grep -E 'flterm|flfiles' ; echo end
@shot @OUT@/a-login.ppm
@key ret
@wait 15
@shot @OUT@/a-desktop.ppm
ls -l /usr/bin/flpower /usr/bin/flmount /usr/bin/flauth
su -s /bin/sh tester -c 'flmount list'
echo ---plug
@mon drive_add 0 if=none,id=u,file=@OUT@/usb.img,format=raw
@mon device_add usb-storage,drive=u,id=ud,bus=xhci.0
@wait 10
su -s /bin/sh tester -c 'flmount list'
grep drives /proc/mounts
ls /drives
su -s /bin/sh tester -c 'echo hello-usb > /drives/TESTUSB/hello.txt && cat /drives/TESTUSB/hello.txt'
ls -l /drives/TESTUSB
@shot @OUT@/a-notify.ppm
su -s /bin/sh tester -c 'export XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus; setsid flfiles >/tmp/files.log 2>&1 </dev/null &'
@wait 6
@shot @OUT@/a-files.ppm
su -s /bin/sh tester -c 'export XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus; flmount unmount /dev/sda; echo unmount-rc=$?'
grep -c drives /proc/mounts
su -s /bin/sh tester -c 'flmount mount /dev/sda; echo mount-rc=$?'
su -s /bin/sh tester -c 'flmount eject /dev/sda; echo eject-rc=$?'
@wait 3
su -s /bin/sh tester -c 'flmount list'
su -s /bin/sh tester -c 'flmount eject /dev/sr0; echo rc=$?'
su -s /bin/sh tester -c 'flmount mount /dev/vda1; echo internal-rc=$?'
