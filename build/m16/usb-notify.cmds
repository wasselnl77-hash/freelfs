@desktop
@mon drive_add 0 if=none,id=u,file=@OUT@/usb.img,format=raw
@mon device_add usb-storage,drive=u,id=ud,bus=xhci.0
@waitok 60 the stick is mounted :: grep -q ' /drives/TESTUSB ' /proc/mounts
@wait 2
@shot @OUT@/b-notify1.ppm
@wait 2
@shot @OUT@/b-notify2.ppm
@ok unmount, mount, eject all work and the device goes away :: su -s /bin/sh tester -c 'flmount unmount /dev/sda1' && ! grep -q ' /drives/TESTUSB ' /proc/mounts && su -s /bin/sh tester -c 'flmount mount /dev/sda1' && grep -q ' /drives/TESTUSB ' /proc/mounts && su -s /bin/sh tester -c 'flmount eject /dev/sda1'; sleep 3; ! test -e /sys/block/sda
@key meta_l
@wait 2
@shot @OUT@/b-menu.ppm
