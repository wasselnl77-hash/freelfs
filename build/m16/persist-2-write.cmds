sync
@ok /home is the persistent image :: grep -qE ' /home | /run/live/persist ' /proc/mounts
ls -la /home /home/tester | head -20
echo persisted-ok > /home/tester/marker.txt; chown 1000:999 /home/tester/marker.txt
@ok the marker file is written :: grep -qx persisted-ok /home/tester/marker.txt
sync
poweroff
@poweroffwait 90
