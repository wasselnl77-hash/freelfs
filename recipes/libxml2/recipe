pkgname=libxml2
version=2.15.4
release=1
summary="XML parser library"
url=https://gitlab.gnome.org/GNOME/libxml2
license=(MIT)
arch=(x86_64)
groups=(desktop)
depends=(glibc zlib icu)
makedepends=(meson ninja)
source=(https://download.gnome.org/sources/libxml2/2.15/libxml2-$version.tar.xz)
sha256=(98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821)
# the meson.build runs git to label development builds; there is no git here
prepare() {
	sed -i "/^r = run_command(.git./,/^endif/d" meson.build
}
build_style=meson
configure_args=(-D history=disabled -D icu=enabled -D python=disabled -D readline=disabled
	-D docs=disabled)
check() { :; }
