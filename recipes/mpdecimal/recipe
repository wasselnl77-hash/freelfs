pkgname=mpdecimal
version=4.0.1
release=1
summary="Arbitrary precision decimal arithmetic"
url=https://www.bytereef.org/mpdecimal/
license=(BSD-2-Clause)
arch=(x86_64 aarch64)
groups=(base)
depends=(glibc gcc-libs)
source=(https://www.bytereef.org/software/mpdecimal/releases/mpdecimal-$version.tar.gz)
sha256=(96d33abb4bb0070c7be0fed4246cd38416188325f820468214471938545b1ac8)

build() {
	./configure --prefix=/usr --disable-static --docdir=/usr/share/doc/mpdecimal-$version
	make
}

check() {
	make check_local
}

package() {
	make DESTDIR="$pkgdir" install
}
