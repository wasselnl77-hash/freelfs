pkgname=sqlite
version=3.54.1
release=1
summary="SQL database engine in a library"
url=https://www.sqlite.org/
license=(LicenseRef-public-domain)
arch=(x86_64)
groups=(base)
depends=(glibc readline zlib)
worksrc=sqlite-autoconf-3540100
source=(https://sqlite.org/2026/sqlite-autoconf-3540100.tar.gz)
sha256=(926ef8d3eab93fbf6e06011901273eec076b25594a4e1cdadd50c987f4f6d64e)

build() {
	./configure --prefix=/usr \
		--disable-static \
		--enable-fts{4,5} \
		CPPFLAGS="-D SQLITE_ENABLE_COLUMN_METADATA=1 \
		          -D SQLITE_ENABLE_UNLOCK_NOTIFY=1 \
		          -D SQLITE_ENABLE_DBSTAT_VTAB=1 \
		          -D SQLITE_SECURE_DELETE=1"
	make LDFLAGS.rpath=""
}

package() {
	make DESTDIR="$pkgdir" install
}
