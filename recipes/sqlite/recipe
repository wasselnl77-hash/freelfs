pkgname=sqlite
version=3.53.4
release=1
summary="SQL database engine in a library"
url=https://www.sqlite.org/
license=(LicenseRef-public-domain)
arch=(x86_64)
groups=(base)
depends=(glibc readline zlib)
worksrc=sqlite-autoconf-3530400
source=(https://sqlite.org/2026/sqlite-autoconf-3530400.tar.gz)
sha256=(0e9483900e92cd5de8fd48d16bf9200145a61f7fd5be542a5ac81d8a9516eb9c)

build() {
	./configure --prefix=/usr \
		--disable-static \
		--enable-fts{4,5} \
		CPPFLAGS="-D SQLITE_ENABLE_COLUMN_METADATA=1 \
		          -D SQLITE_ENABLE_UNLOCK_NOTIFY=1 \
		          -D SQLITE_ENABLE_DBSTAT_VTAB=1 \
		          -D SQLITE_SECURE_DELETE=1"
	make LDFLAGS.rpath=""
}

package() {
	make DESTDIR="$pkgdir" install
}
