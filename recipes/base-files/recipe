# The FreeLFS file system layout (/sysflfs for the system, /usr for people's
# homes, the classic names as links), the standard system accounts and the
# basic files in /etc. The files come from config/etc in the FreeLFS tree. The
# accounts are declared, not shipped: /etc/passwd and /etc/group belong to
# no package, so upgrades never drop users.
pkgname=base-files
version=0.1
release=3
summary="FreeLFS file system layout, system accounts and basic /etc files"
license=(MIT)
arch=(any)
groups=(base)
options=(!pathcheck)
sysgroups=("root 0" "bin 1" "sys 2" "kmem 3" "tape 4" "tty 5" "daemon 6" "floppy 7"
	"disk 8" "lp 9" "dialout 10" "audio 11" "video 12" "utmp 13" "clock 14"
	"cdrom 15" "adm 16" "messagebus 18" "netdev 86" "input 24" "render 30" "sgx 31"
	"mail 34" "kvm 61" "uuidd 80" "wheel 97" "seat 98" "users 999" "nogroup 65534")
sysusers=("root 0 0 /root /bin/bash root"
	"bin 1 1 /dev/null /usr/bin/false bin"
	"daemon 6 6 /dev/null /usr/bin/false 'Daemon User'"
	"messagebus 18 18 /run/dbus /usr/bin/false 'D-Bus Message Daemon User'"
	"uuidd 80 80 /dev/null /usr/bin/false 'UUID Generation Daemon User'"
	"nobody 65534 65534 /dev/null /usr/bin/false 'Unprivileged User'")
source=()
sha256=()

package() {
	local etc=$startdir/../../config/etc d S=sysflfs
	cd "$pkgdir"
	# The system itself lives in /sysflfs; people's homes are in /usr.
	install -d boot dev drives proc run sys usr \
		$S/{bin,include,lib,libexec,sbin,src,opt,srv} $S/lib/{firmware,locale} \
		$S/local/{bin,include,lib,sbin,src} \
		$S/settings/{opt,sysconfig,profile.d} \
		$S/data/{cache,local,log,mail,opt,spool} $S/data/lib/{color,misc,locate,hwclock}
	for d in $S/share $S/local/share; do
		install -d $d/{color,dict,doc,info,locale,man,misc,terminfo,zoneinfo} $d/man/man{1..8}
	done
	# The classic names stay as links, for every program that expects them:
	# /usr/bin, /etc, /var, /bin/sh, /home, ... They are relative, so they
	# also work in a root that is not mounted at /.
	for d in bin include lib libexec local sbin share src; do
		ln -s ../$S/$d usr/$d
	done
	ln -s $S/settings etc
	ln -s $S/data var
	ln -s $S/bin bin
	ln -s $S/lib lib
	ln -s $S/sbin sbin
	ln -s $S/opt opt
	ln -s $S/srv srv
	ln -s usr home
	ln -s drives mnt
	ln -s drives media
	install -d -m 0750 $S/root
	ln -s $S/root root
	# glibc's dynamic linker path is fixed by the ABI: a real directory
	[ "$CARCH" != x86_64 ] || install -d lib64
	ln -s /run $S/data/run
	ln -s /run/lock $S/data/lock
	ln -s /proc/self/mounts $S/settings/mtab
	install -d -m 0700 .snapshots
	install -d -m 1777 tmp $S/data/tmp
	install -m644 "$etc"/{fstab,hostname,hosts,inputrc,issue,os-release,profile,shells} $S/settings/
	# New users get lowercase folders (useradd copies skel)
	install -d $S/settings/skel/{desktop,documents,downloads,music,pictures,videos,.config}
	cat > $S/settings/skel/.config/user-dirs.dirs <<-'EOF'
		XDG_DESKTOP_DIR="$HOME/desktop"
		XDG_DOCUMENTS_DIR="$HOME/documents"
		XDG_DOWNLOAD_DIR="$HOME/downloads"
		XDG_MUSIC_DIR="$HOME/music"
		XDG_PICTURES_DIR="$HOME/pictures"
		XDG_VIDEOS_DIR="$HOME/videos"
		XDG_TEMPLATES_DIR="$HOME"
		XDG_PUBLICSHARE_DIR="$HOME"
	EOF
	# What file managers leave out (the .hidden convention)
	printf '%s\n' bin dev etc home lib lib64 media mnt opt proc root run sbin srv sys tmp var > .hidden
	printf '%s\n' bin include lib libexec local sbin share src > usr/.hidden
}
