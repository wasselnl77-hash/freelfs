# The FreeLFS file system layout, the standard system accounts and the basic files in /etc.
# Release 4: the normal FHS layout underneath. /usr is the real system directory (bin, lib,
# share, ...), /sysflfs is a link to it (the FreeLFS name for the system, and every old
# /sysflfs/... path keeps working), /etc and /var are real directories, and people's homes are
# /home/NAME (the btrfs subvolume @home). Releases 1 to 3 had it the other way round: the system
# in a real /sysflfs, /usr a link farm on @home holding the homes (docs/PLAN.md, "Folder layout").
# The files come from config/etc in the FreeLFS tree. The
# accounts are declared, not shipped: /etc/passwd and /etc/group belong to
# no package, so upgrades never drop users.
pkgname=base-files
version=0.1
release=4
summary="FreeLFS file system layout, system accounts and basic /etc files"
license=(MIT)
arch=(any)
groups=(base)
options=(!pathcheck)
sysgroups=("root 0" "bin 1" "sys 2" "kmem 3" "tape 4" "tty 5" "daemon 6" "floppy 7"
	"disk 8" "lp 9" "dialout 10" "audio 11" "video 12" "utmp 13" "clock 14"
	"cdrom 15" "adm 16" "messagebus 18" "netdev 86" "input 24" "render 30" "sgx 31"
	"mail 34" "kvm 61" "uuidd 80" "wheel 97" "seat 98" "users 999" "nogroup 65534")
sysusers=("root 0 0 /root /bin/bash root"
	"bin 1 1 /dev/null /usr/bin/false bin"
	"daemon 6 6 /dev/null /usr/bin/false 'Daemon User'"
	"messagebus 18 18 /run/dbus /usr/bin/false 'D-Bus Message Daemon User'"
	"uuidd 80 80 /dev/null /usr/bin/false 'UUID Generation Daemon User'"
	"nobody 65534 65534 /dev/null /usr/bin/false 'Unprivileged User'")
source=()
sha256=()

package() {
	local etc=$startdir/../../config/etc d
	cd "$pkgdir"
	install -d boot dev drives home proc run sys etc var opt srv \
		usr/{bin,include,lib,libexec,sbin,src} usr/lib/{firmware,locale} \
		usr/local/{bin,include,lib,sbin,src} \
		etc/{opt,sysconfig,profile.d} \
		var/{cache,local,log,mail,opt,spool} var/lib/{color,misc,locate,hwclock}
	for d in usr/share usr/local/share; do
		install -d $d/{color,dict,doc,info,locale,man,misc,terminfo,zoneinfo} $d/man/man{1..8}
	done
	# /sysflfs is the FreeLFS name for the system: a link to /usr. The merged-/usr links
	# (/bin, /lib, /sbin) as everywhere else. All relative, so they also work in a root that
	# is not mounted at /.
	ln -s usr sysflfs
	ln -s usr/bin bin
	ln -s usr/lib lib
	ln -s usr/sbin sbin
	ln -s drives mnt
	ln -s drives media
	install -d -m 0750 root
	# glibc's dynamic linker path is fixed by the ABI: a real directory
	[ "$CARCH" != x86_64 ] || install -d lib64
	ln -s /run var/run
	ln -s /run/lock var/lock
	ln -s /proc/self/mounts etc/mtab
	install -d -m 0700 .snapshots
	install -d -m 1777 tmp var/tmp
	install -m644 "$etc"/{fstab,hostname,hosts,inputrc,issue,os-release,profile,shells} etc/
	# New users get lowercase folders (useradd copies skel)
	install -d etc/skel/{desktop,documents,downloads,music,pictures,videos,.config}
	cat > etc/skel/.config/user-dirs.dirs <<-'EOF'
		XDG_DESKTOP_DIR="$HOME/desktop"
		XDG_DOCUMENTS_DIR="$HOME/documents"
		XDG_DOWNLOAD_DIR="$HOME/downloads"
		XDG_MUSIC_DIR="$HOME/music"
		XDG_PICTURES_DIR="$HOME/pictures"
		XDG_VIDEOS_DIR="$HOME/videos"
		XDG_TEMPLATES_DIR="$HOME"
		XDG_PUBLICSHARE_DIR="$HOME"
	EOF
	# What file managers leave out (the .hidden convention): / shows boot, drives, home and
	# sysflfs (the system, which is /usr under its classic name)
	printf '%s\n' bin dev etc lib lib64 media mnt opt proc root run sbin srv sys tmp usr var > .hidden
}
