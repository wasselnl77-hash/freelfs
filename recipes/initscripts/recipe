# FreeLFS's own boot scripts: the inittab, /etc/rc.conf and the rc.d
# scripts. They come from config/etc in the FreeLFS tree.
pkgname=initscripts
version=0.1
release=17
summary="FreeLFS boot scripts: rc.sysinit, rc, rc.shutdown and services"
license=(MIT)
arch=(any)
groups=(base)
depends=(bash sysvinit util-linux procps-ng kmod iproute2 udev coreutils nftables)
source=()
sha256=()

package() {
	local etc=$startdir/../../config/etc
	install -Dm644 "$etc/inittab" "$pkgdir/etc/inittab"
	install -Dm644 "$etc/rc.conf" "$pkgdir/etc/rc.conf"
	install -Dm644 "$etc/rc.d/functions" "$pkgdir/etc/rc.d/functions"
	install -m755 "$etc"/rc.d/{rc,rc.sysinit,rc.shutdown,serial-getty} "$pkgdir/etc/rc.d/"
	install -d "$pkgdir/etc/rc.d/init.d"
	install -m755 "$etc"/rc.d/init.d/* "$pkgdir/etc/rc.d/init.d/"
	# round 23: kernel hardening sysctls, the default firewall (nftables.conf, the firewall service, the mDNS hook)
	install -Dm644 "$etc/sysctl.d/10-freelfs-hardening.conf" "$pkgdir/etc/sysctl.d/10-freelfs-hardening.conf"
	install -Dm644 "$etc/nftables.conf" "$pkgdir/etc/nftables.conf"
	install -Dm755 "$etc/rc.d/fl-firewall-mdns" "$pkgdir/usr/libexec/fl-firewall-mdns"
}
