pkgname=dejagnu
version=1.6.3
release=1
summary="Framework for testing other programs"
url=https://www.gnu.org/software/dejagnu/
license=(GPL-3.0-or-later)
arch=(any)
groups=(base)
depends=(expect)
source=(https://ftpmirror.gnu.org/dejagnu/dejagnu-$version.tar.gz)
sha256=(87daefacd7958b4a69f88c6856dbd1634261963c414079d0c371f589cd66a2e3)

build() {
	mkdir -p build
	cd build
	../configure --prefix=/usr
	makeinfo --html --no-split -o doc/dejagnu.html ../doc/dejagnu.texi
	makeinfo --plaintext -o doc/dejagnu.txt ../doc/dejagnu.texi
}

check() {
	cd build
	make check
}

package() {
	cd build
	make DESTDIR="$pkgdir" install
	install -Dm644 doc/dejagnu.{html,txt} -t "$pkgdir/usr/share/doc/dejagnu-$version"
}
