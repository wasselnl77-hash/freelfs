pkgname=mpc
version=1.4.1
release=1
summary="Complex number arithmetic library"
url=https://www.multiprecision.org/mpc/
license=(LGPL-3.0-or-later)
arch=(x86_64)
groups=(base)
depends=(gmp mpfr)
source=(https://ftpmirror.gnu.org/mpc/mpc-$version.tar.xz)
sha256=(91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931)

build() {
	./configure --prefix=/usr --disable-static --docdir=/usr/share/doc/mpc-$version
	make
	make html
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install install-html
}
