pkgname=groff
version=1.24.1
release=1
summary="GNU troff text formatter"
url=https://www.gnu.org/software/groff/
license=(GPL-3.0-or-later)
arch=(x86_64)
groups=(base)
depends=(glibc gcc-libs perl)
source=(https://ftpmirror.gnu.org/groff/groff-$version.tar.gz)
sha256=(74e2819795b6aff431aeac983d63a9c8968eeaba2a2eba7df8ba4c7b41e7cfd8)

build() {
	PAGE=A4 ./configure --prefix=/usr
	make -j1
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}
