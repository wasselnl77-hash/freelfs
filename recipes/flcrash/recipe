# flcrash, from src/flcrash in the FreeLFS tree.
pkgname=flcrash
version=0.1
release=3
summary="The FreeLFS \"Something went wrong\" screen, shown when the desktop session dies"
license=(MIT)
arch=(x86_64)
groups=(desktop)
depends=(glibc flui seatd libdrm libinput)
makedepends=(flui seatd libdrm libinput)
source=()
sha256=()

build() {
	cp -r "$startdir/../../src/flcrash" "$srcdir/flcrash"
	cd "$srcdir/flcrash"
	make clean
	make
}

package() {
	cd "$srcdir/flcrash"
	make DESTDIR="$pkgdir" install
}
