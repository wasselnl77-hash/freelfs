license=(LGPL-2.1-or-later AND BSD-2-Clause)
arch=(x86_64)
groups=(desktop)
depends=(glibc gcc glib glib-networking libsoup libxml2 libxslt icu harfbuzz freetype fontconfig libjpeg-turbo libpng libwebp libgcrypt libtasn1 libepoxy sqlite libwpe wpebackend-fdo libxkbcommon mesa libdrm wayland woff2 lcms2 gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad gst-libav zlib libseccomp bubblewrap xdg-dbus-proxy)
makedepends=(cmake ninja python perl ruby gperf unifdef pkgconf libseccomp bubblewrap xdg-dbus-proxy)
source=(https://wpewebkit.org/releases/wpewebkit-$version.tar.xz)
sha256=(f3284e19e47fcb5ac8c63c2e1c113dbd65b2423eb8a545f5b345707829004f56)
# Legacy WPE API (libwpe + wpebackend-fdo), which is what FreeBWS embeds: the
# web process draws to a nested Wayland display inside the UI process, and
# the UI process gets dmabuf (GPU) or shm (llvmpipe) buffers per frame.
# Off: GTK, X11, introspection, docs, journald, speech, WebDriver, gamepad,
# WebRTC, media stream/recorder, GPU process (one process less), JPEG-XL,
# AVIF, hyphenation, libbacktrace, sysprof, ATK.
# 2.54.2 (the 2.52 series gets no more fixes: the September 2026 advisory WSA-2026-0006 lists about 230
# CVEs fixed from 2.54.0 on). The legacy WPE API and the options below are unchanged in 2.54.
# On since the 2.52.5-2 build: the bubblewrap sandbox of the web processes (docs/SECURITY.md).
# WebKit then starts every web process through /usr/bin/bwrap (seccomp filter from
# libseccomp, session bus through /usr/bin/xdg-dbus-proxy); both paths are compiled in.
# In the WPE 2.0 API it is on by default; FreeBWS checks that bwrap runs and says so
# when it does not (WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1 is what turns it off).
# The flag changes config.h and compiler definitions: a full rebuild, hours, not minutes.
prepare() {
	# CMake 4.x does not parse an unquoted empty variable in this condition
	sed -i 's/(${framework} STREQUAL ${_linked_into})/("${framework}" STREQUAL "${_linked_into}")/;
		s/(NOT ${_linked_into} IN_LIST/(NOT "${_linked_into}" IN_LIST/' Source/cmake/WebKitMacros.cmake
}

# The build takes hours and flpkg starts every build in an empty directory, so
# a build dir kept in /.bootstrap/pkg/wpewebkit-resume (left there when ninja
# fails or is stopped) is put back first: ninja then goes on where it was.
build() {
	resume=/.bootstrap/pkg/wpewebkit-resume
	if [ -d $resume/build ]; then
		mv $resume/build build
		rmdir $resume
	fi
	cmake -S . -B build -G Ninja -D PORT=WPE -D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_SKIP_INSTALL_RPATH=ON \
		-D CMAKE_C_FLAGS_RELEASE="-O2 -DNDEBUG -g0" -D CMAKE_CXX_FLAGS_RELEASE="-O2 -DNDEBUG -g0" \
		-D LIB_INSTALL_DIR=/usr/lib -D LTO_MODE=OFF \
		-D ENABLE_DOCUMENTATION=OFF -D ENABLE_INTROSPECTION=OFF -D ENABLE_JOURNALD_LOG=OFF \
		-D ENABLE_WPE_PLATFORM=OFF -D ENABLE_WPE_LEGACY_API=ON -D ENABLE_WPE_QT_API=OFF \
		-D ENABLE_MINIBROWSER=OFF -D ENABLE_COG=OFF \
		-D USE_ATK=OFF -D USE_LIBBACKTRACE=OFF -D USE_LIBHYPHEN=OFF -D USE_SYSPROF_CAPTURE=OFF \
		-D USE_AVIF=OFF -D USE_JPEGXL=OFF -D USE_LCMS=ON -D USE_WOFF2=ON -D USE_FLITE=OFF \
		-D ENABLE_SPEECH_SYNTHESIS=OFF -D ENABLE_SPELLCHECK=OFF -D ENABLE_BUBBLEWRAP_SANDBOX=ON -D ENABLE_WEBDRIVER=OFF \
		-D BWRAP_EXECUTABLE=/usr/bin/bwrap -D DBUS_PROXY_EXECUTABLE=/usr/bin/xdg-dbus-proxy \
		-D ENABLE_GAMEPAD=OFF -D ENABLE_WEB_RTC=OFF -D USE_GSTREAMER_WEBRTC=OFF \
		-D ENABLE_MEDIA_STREAM=OFF -D ENABLE_MEDIA_RECORDER=OFF -D ENABLE_GPU_PROCESS=OFF \
		-D ENABLE_API_TESTS=OFF -D ENABLE_LAYOUT_TESTS=OFF -D USE_SYSTEM_UNIFDEF=ON \
		"${configure_args[@]}"
	ninja -C build ${NINJAJOBS:+-j$NINJAJOBS} || {
		mkdir -p $resume && mv build $resume/build
		return 1
	}
}
check() { :; }
package() { DESTDIR="$pkgdir" ninja -C build install; }
