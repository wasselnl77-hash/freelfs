pkgname=efibootmgr
version=18
release=1
summary="Show and change the UEFI boot entries and the boot order"
url=https://github.com/rhboot/efibootmgr
license=(GPL-2.0-or-later)
arch=(x86_64)
groups=(base)
depends=(glibc efivar)
makedepends=(glibc efivar)
source=(efibootmgr-$version.tar.gz::https://github.com/rhboot/efibootmgr/archive/refs/tags/$version.tar.gz)
sha256=(442867d12f8525034a404fc8af3036dba8e1fc970998af2486c3b940dfad0874)

# only efibootmgr itself: the other tools of the tarball need popt
build() {
	make -C src efibootmgr EFIDIR=freelfs EXTRAVERSION= CFLAGS="-O2 -Wno-error"
}

package() {
	install -Dm755 src/efibootmgr "$pkgdir/usr/sbin/efibootmgr"
	install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/efibootmgr"
}
