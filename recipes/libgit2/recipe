# libgit2 >= 1.9: Nix's fetchers (git sources, flakes). HTTPS through OpenSSL, no SSH, no CLI.
pkgname=libgit2
version=1.9.2
release=1
summary="Portable C implementation of the Git core methods"
url=https://libgit2.org
license=(GPL-2.0-only-with-linking-exception)
arch=(x86_64)
groups=(buildtool)
depends=(glibc zlib openssl)
makedepends=(cmake ninja)
source=(https://github.com/libgit2/libgit2/archive/refs/tags/v1.9.2.tar.gz)
sha256=(6f097c82fc06ece4f40539fb17e9d41baf1a5a2fc26b1b8562d21b89bc355fe6)
worksrc=libgit2-1.9.2
build_style=cmake
configure_args=(-D BUILD_TESTS=OFF -D BUILD_CLI=OFF -D BUILD_EXAMPLES=OFF
	-D USE_SSH=OFF -D USE_HTTPS=OpenSSL -D USE_BUNDLED_ZLIB=OFF
	-D REGEX_BACKEND=builtin -D USE_GSSAPI=OFF -D USE_NTLMCLIENT=OFF)
check() { :; }
