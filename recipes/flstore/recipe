# flstore (the Software Store), from src/flstore in the FreeLFS tree. It replaces the
# Packages app on the desktop; flpkg-seat, the setuid helper for FreeLFS packages, still
# comes from flpackages (hidden there), which is why the store depends on it.
pkgname=flstore
version=0.1
release=4
summary="FreeLFS Software Store: Flathub apps and FreeLFS packages, install, update, remove"
license=(MIT)
arch=(x86_64)
groups=(desktop)
depends=(glibc flui wayland flpkg flpackages flatpak curl ca-certificates libxml2 libpng libjpeg-turbo libwebp zlib)
makedepends=(flui libxml2 libpng libjpeg-turbo libwebp zlib)
source=()
sha256=()

build() {
	cp -r "$startdir/../../src/flstore" "$srcdir/flstore"
	cd "$srcdir/flstore"
	make clean
	make
}

package() {
	cd "$srcdir/flstore"
	make DESTDIR="$pkgdir" install
}
