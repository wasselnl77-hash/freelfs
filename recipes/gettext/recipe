pkgname=gettext
version=1.0
release=1
summary="GNU internationalisation tools"
url=https://www.gnu.org/software/gettext/
license=(GPL-3.0-or-later LGPL-2.1-or-later)
arch=(x86_64 aarch64)
groups=(base)
depends=(glibc gcc-libs acl attr ncurses)
source=(https://ftpmirror.gnu.org/gettext/gettext-$version.tar.xz)
sha256=(71132a3fb71e68245b8f2ac4e9e97137d3e5c02f415636eb508ae607bc01add7)
build_style=autotools
configure_args=(--disable-static --docdir=/usr/share/doc/gettext-$version)

package() {
	make DESTDIR="$pkgdir" install
	chmod 0755 "$pkgdir/usr/lib/preloadable_libintl.so"
}
