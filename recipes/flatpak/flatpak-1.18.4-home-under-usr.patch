+/* FreeLFS keeps home directories in /usr (/usr/NAME), which Flatpak reserves: nothing under /usr is
+ * exported, because /usr in the sandbox is the read-only runtime and bwrap cannot make mount points
+ * in it. That is why --filesystem=home and ~/.var/app/APP did not reach the sandbox.
+ *
+ * The user's own $HOME (and what is below it) is allowed when its mount point is ready:
+ * flatpak_exports_prepare_home_under_usr() makes the (empty) directory in the runtime's files, which
+ * belongs to the user in a per-user install, before bwrap gets the runtime as /usr. The rest of
+ * /usr stays reserved. In the sandbox $HOME is a tmpfs unless it is exported itself, so that the
+ * directories below it can be created. If the directory cannot be made nothing changes from before.
+ * own_home_under_usr is the canonical $HOME, set only when it is inside /usr and ready. */
+static char *own_home_under_usr = NULL;
+
+void
+flatpak_exports_prepare_home_under_usr (int runtime_fd)
+{
+  g_autofree char *home = flatpak_canonicalize_filename (g_get_home_dir ());
+  g_autoptr(GError) local_error = NULL;
+
+  g_clear_pointer (&own_home_under_usr, g_free);
+
+  if (!g_str_has_prefix (home, "/usr/") || home[strlen ("/usr/")] == 0)
+    return;
+
+  if (!glnx_shutil_mkdir_p_at (runtime_fd, home + strlen ("/usr/"), 0755, NULL, &local_error))
+    {
+      g_info ("No mount point for %s in the runtime, the home directory stays out of the sandbox: %s",
+              home, local_error->message);
+      return;
+    }
+
+  own_home_under_usr = g_steal_pointer (&home);
+}
+
+static gboolean
+is_own_home_under_usr (const char *path)
+{
+  return own_home_under_usr != NULL && flatpak_has_path_prefix (path, own_home_under_usr);
+}
