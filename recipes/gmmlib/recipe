# Intel's graphics memory management library: only intel-media-driver (VA-API for Intel
# Broadwell and newer) uses it.
pkgname=gmmlib
version=22.10.2
release=1
worksrc=gmmlib-intel-gmmlib-$version
summary="Intel Graphics Memory Management library"
url=https://github.com/intel/gmmlib
license=(MIT)
arch=(x86_64)
groups=(desktop)
depends=(glibc gcc)
makedepends=(cmake ninja)
source=(gmmlib-$version.tar.gz::https://github.com/intel/gmmlib/archive/refs/tags/intel-gmmlib-$version.tar.gz)
sha256=(94d0038ef92bb65b86d08f004197c56f8d81f82f9ac7a25c202a88afd653a30b)
build_style=cmake
configure_args=(-D BUILD_TYPE=Release -D RUN_TEST_SUITE=OFF -D CMAKE_BUILD_TYPE=Release -D BUILD_SHARED_LIBS=ON -D CMAKE_POLICY_VERSION_MINIMUM=3.5)
check() { :; }
