pkgname=expat
version=2.8.3
release=1
summary="XML parser library"
url=https://libexpat.github.io/
license=(MIT)
arch=(x86_64)
groups=(base)
depends=(glibc)
source=(https://github.com/libexpat/libexpat/releases/download/R_2_8_3/expat-$version.tar.xz)
sha256=(f6256df90c906773d344da084402b7d3e4f22ed41b1a59c989098a83d3ea0c85)
build_style=autotools
configure_args=(--disable-static --docdir=/usr/share/doc/expat-$version)

package() {
	make DESTDIR="$pkgdir" install
	install -m644 doc/*.{html,css} "$pkgdir/usr/share/doc/expat-$version"
}
