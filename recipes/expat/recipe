pkgname=expat
version=2.10.0
release=1
summary="XML parser library"
url=https://libexpat.github.io/
license=(MIT)
arch=(x86_64)
groups=(base)
depends=(glibc)
source=(https://github.com/libexpat/libexpat/releases/download/R_2_10_0/expat-$version.tar.xz)
sha256=(c624ba2998fc65df1163a49641ff3f9ab73138b11641d92c86bee0fb01b1bc7f)
build_style=autotools
configure_args=(--disable-static --docdir=/usr/share/doc/expat-$version)

package() {
	make DESTDIR="$pkgdir" install
	install -m644 doc/*.{html,css} "$pkgdir/usr/share/doc/expat-$version"
}
