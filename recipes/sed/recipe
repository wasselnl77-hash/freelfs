pkgname=sed
version=4.10
release=1
summary="GNU stream editor"
url=https://www.gnu.org/software/sed/
license=(GPL-3.0-or-later)
arch=(x86_64)
groups=(base)
depends=(glibc acl attr)
source=(https://ftpmirror.gnu.org/sed/sed-$version.tar.xz)
sha256=(b8e72182b2ec96a3574e2998c47b7aaa64cc20ce000d8e9ac313cc07cecf28c7)

build() {
	./configure --prefix=/usr
	make
	make html
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 doc/sed.html -t "$pkgdir/usr/share/doc/sed-$version"
}
