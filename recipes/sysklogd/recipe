pkgname=sysklogd
version=2.7.2
release=1
summary="System logging daemon"
url=https://github.com/troglobit/sysklogd
license=(BSD-3-Clause)
arch=(x86_64)
groups=(base)
depends=(glibc)
source=(https://github.com/troglobit/sysklogd/releases/download/v$version/sysklogd-$version.tar.gz)
sha256=(bc410ca64551a11fac6518b418fb6b8afbd888a70af2c5eb353334a706727bca)
build_style=autotools
configure_args=(--sysconfdir=/etc --runstatedir=/run --without-logger --disable-static
	--docdir=/usr/share/doc/sysklogd-$version)

package() {
	make DESTDIR="$pkgdir" install
	install -d "$pkgdir/etc"
	cat > "$pkgdir/etc/syslog.conf" <<-"EOF"
		# /etc/syslog.conf

		auth,authpriv.* -/var/log/auth.log
		*.*;auth,authpriv.none -/var/log/sys.log
		daemon.* -/var/log/daemon.log
		kern.* -/var/log/kern.log
		mail.* -/var/log/mail.log
		user.* -/var/log/user.log
		*.emerg *

		# Do not open any internet ports.
		secure_mode 2
	EOF
}
