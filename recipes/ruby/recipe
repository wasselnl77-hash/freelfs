pkgname=ruby
version=4.0.6
release=1
summary="Ruby (build tool of WebKit's JavaScriptCore)"
url=https://www.ruby-lang.org/
license=(Ruby OR BSD-2-Clause)
arch=(x86_64 aarch64)
groups=(desktop)
depends=(glibc zlib openssl libyaml libffi readline)
makedepends=()
source=(https://cache.ruby-lang.org/pub/ruby/4.0/ruby-$version.tar.xz)
sha256=(9c9d121fe3314ea7c801e690b9de981d2b9d12d7849db99c27482468a541ba0a)
build() {
	./configure --prefix=/usr --disable-rpath --enable-shared --without-valgrind \
		--without-baseruby ac_cv_func_qsort_r=no --disable-install-doc
	make
}
check() { :; }
package() { make DESTDIR="$pkgdir" install; }
