pkgname=flpdf
version=0.1
release=4
summary="FreeLFS document viewer: PDF, XPS, EPUB, CBZ; contents, search, zoom"
license=(MIT)
arch=(x86_64)
groups=(desktop)
depends=(glibc gcc flui wayland mupdf freetype harfbuzz libjpeg-turbo zlib brotli)
makedepends=(flui mupdf)
source=()
sha256=()

build() {
	cp -r "$startdir/../../src/flpdf" "$srcdir/flpdf"
	cd "$srcdir/flpdf"
	make clean
	make
}

package() {
	cd "$srcdir/flpdf"
	make DESTDIR="$pkgdir" install
}
