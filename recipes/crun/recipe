# crun: the OCI runtime podman uses (C, small; instead of runc, which is Go and 3x the size).
pkgname=crun
version=1.31
release=1
summary="Fast and light OCI container runtime"
url=https://github.com/containers/crun
license=(GPL-2.0-or-later)
arch=(x86_64)
groups=(desktop)
depends=(glibc libcap libseccomp json-c)
makedepends=(pkgconf)
source=(https://github.com/containers/crun/releases/download/$version/crun-$version.tar.gz)
sha256=(17d04ba159fada1f1300a36b8afe869afb38bf1bbda28da052e83bb4bee20108)
build_style=autotools
configure_args=(--disable-systemd --disable-criu --disable-static --disable-shared)
check() { :; }
