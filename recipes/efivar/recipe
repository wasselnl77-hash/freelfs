pkgname=efivar
version=39
release=1
summary="Library and tool for the UEFI variables (efibootmgr needs it)"
url=https://github.com/rhboot/efivar
license=(LGPL-2.1-or-later)
arch=(x86_64)
groups=(desktop)
depends=(glibc)
makedepends=(glibc)
source=(efivar-$version.tar.gz::https://github.com/rhboot/efivar/archive/refs/tags/$version.tar.gz)
sha256=(c9edd15f2eeeea63232f3e669a48e992c7be9aff57ee22672ac31f5eca1609a6)

build() {
	make -j1 prefix=/usr libdir=/usr/lib bindir=/usr/bin includedir=/usr/include ENABLE_DOCS=0 \
		CFLAGS="-O2 -Wno-error" HOSTCFLAGS="-O2 -Wno-error"
}

package() {
	make prefix=/usr libdir=/usr/lib bindir=/usr/bin includedir=/usr/include ENABLE_DOCS=0 \
		DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.a
	rm -rf "$pkgdir/usr/share/man"
	install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/efivar"
}
