pkgname=seatd
version=0.9.3
release=1
summary="Minimal seat management daemon and libseat"
url=https://sr.ht/~kennylevinsen/seatd/
license=(MIT)
arch=(x86_64 aarch64)
groups=(desktop)
depends=(glibc)
source=(https://github.com/kennylevinsen/seatd/archive/$version/seatd-$version.tar.gz)
sha256=(302564d54d8e28191fadfd734f2675ecb0c9e0615a58011b89ef15dfa4dbaa96)
build_style=meson
# BLFS builds only libseat on top of logind; FreeLFS has no logind (sysvinit),
# so build the seatd daemon, libseat's seatd client and the built-in server
# backend, and no logind backend.
configure_args=(-D server=enabled -D libseat-seatd=enabled -D libseat-builtin=enabled
	-D libseat-logind=disabled -D man-pages=disabled -D examples=disabled)
