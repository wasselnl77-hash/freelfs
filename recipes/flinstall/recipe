# flinstall (the graphical installer, "FreeLFS install") and flinstall-helper (its setuid
# helper), from src/flinstall in the FreeLFS tree. The window reuses the Wi-Fi page of
# flsettings (src/flsettings/wifi.c) and libflui's world map. The start menu entry is
# shown on the live system only (TryExec=/run/live), and the helper refuses to touch a disk
# anywhere else.
pkgname=flinstall
version=0.1
release=2
summary="FreeLFS installer: language, keyboard, Wi-Fi, disk, account, time zone, install"
license=(MIT)
arch=(x86_64)
groups=(desktop)
depends=(glibc flui wayland dbus libxcrypt util-linux btrfs-progs dosfstools mtools e2fsprogs flboot flpanel)
# the helper runs as root for the group seat, like flpower in flpanel and fltime-set
owner=("/usr/libexec/flinstall-helper 0 98 4750")
makedepends=(flui dbus libxcrypt)
source=()
sha256=()

build() {
	cp -r "$startdir/../../src/flinstall" "$srcdir/flinstall"
	cd "$srcdir/flinstall"
	make clean
	# the Wi-Fi page is flsettings's
	cp "$startdir/../../src/flsettings/wifi.c" "$startdir/../../src/flsettings/wifi.h" .
	make
}

package() {
	cd "$srcdir/flinstall"
	make DESTDIR="$pkgdir" install
}
