pkgname=pciutils
version=3.14.0
release=1
summary="lspci and setpci: list and configure PCI devices (what a bug report needs)"
url=https://mj.ucw.cz/sw/pciutils/
license=(GPL-2.0-or-later)
arch=(x86_64)
groups=(base)
depends=(glibc)
source=(https://mirrors.edge.kernel.org/pub/software/utils/pciutils/pciutils-$version.tar.xz)
sha256=(e7713409882813991d2269d125e40dad1f54a019a52b78b3962941c1d4a6f86f)

# no zlib, no DNS lookups, no udev hwdb: pci.ids from the tarball is the name table. Static libpci (nothing links it).
build() {
	make PREFIX=/usr SBINDIR=/usr/sbin SHAREDIR=/usr/share/hwdata MANDIR=/usr/share/man \
		SHARED=no ZLIB=no DNS=no HWDB=no
}

package() {
	make PREFIX=/usr SBINDIR=/usr/sbin SHAREDIR=/usr/share/hwdata MANDIR=/usr/share/man \
		SHARED=no ZLIB=no DNS=no HWDB=no DESTDIR="$pkgdir" install
	rm -f "$pkgdir/usr/sbin/update-pciids" "$pkgdir/usr/share/man/man8/update-pciids.8"
	rm -rf "$pkgdir/usr/include" "$pkgdir/usr/lib/pkgconfig" "$pkgdir/usr/lib/libpci.a"
	# lspci installs into /usr/bin: every user can run it (a bug report), setpci is in /usr/sbin
	install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/pciutils"
}
