pkgname=libwebp
version=1.6.0
release=1
summary="WebP image codec"
url=https://developers.google.com/speed/webp
license=(BSD-3-Clause)
arch=(x86_64)
groups=(desktop)
depends=(glibc libjpeg-turbo libpng)
makedepends=()
source=(https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-$version.tar.gz)
sha256=(e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564)
build_style=autotools
configure_args=(--enable-libwebpmux --enable-libwebpdemux --enable-libwebpdecoder
	--enable-libwebpextras --disable-static --disable-gl --disable-sdl --disable-tiff --disable-gif)
check() { :; }
