pkgname=flvideo
version=0.1
release=5
summary="FreeLFS video player: libmpv software rendering, VA-API, subtitles, resume"
license=(MIT)
arch=(x86_64)
groups=(desktop)
depends=(glibc flui wayland mpv dbus xdg-desktop-portal)
makedepends=(flui mpv pkgconf dbus)
source=()
sha256=()

build() {
	cp -r "$startdir/../../src/flvideo" "$srcdir/flvideo"
	cd "$srcdir/flvideo"
	make clean
	make
}

package() {
	cd "$srcdir/flvideo"
	make DESTDIR="$pkgdir" install
}
