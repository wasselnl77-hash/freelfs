pkgname=libdrm
version=2.4.134
release=1
summary="Userspace library for the kernel Direct Rendering Manager"
url=https://dri.freedesktop.org/libdrm/
license=(MIT)
arch=(x86_64)
groups=(desktop)
depends=(glibc udev)
source=(https://dri.freedesktop.org/libdrm/libdrm-$version.tar.xz)
sha256=(ac5e74d157830eb8bee44c6a6bf3ad49774ef0dd2a72bdad74a8f20308b52a95)
