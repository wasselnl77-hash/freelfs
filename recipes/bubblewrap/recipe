# Unprivileged sandboxing with user namespaces (not setuid): what Flatpak runs
# apps in. Needs CONFIG_USER_NS, which the FreeLFS kernel has.
pkgname=bubblewrap
version=0.13.1
release=1
summary="Unprivileged sandboxing tool (bwrap)"
url=https://github.com/containers/bubblewrap
license=(LGPL-2.0-or-later)
arch=(x86_64 aarch64)
groups=(desktop)
depends=(glibc libcap)
makedepends=(meson ninja python)
source=(https://github.com/containers/bubblewrap/releases/download/v$version/bubblewrap-$version.tar.xz)
sha256=(0e85c8702248b8dd64144f594147553650cdd0e4c951690345faace79c217c4d)
build_style=meson
configure_args=(-D selinux=disabled -D man=disabled -D tests=false -D bash_completion=disabled
	-D zsh_completion=disabled)
check() { :; }
