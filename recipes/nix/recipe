# Nix 2.35.6 (multi-user), built from the official source release on GitHub (tag 2.35.6, the
# tarball GitHub generates for it; nixos.org hosts no source tarball for this release).
# The Nix store lives in /nix (RAM on a live system without persistence: flpkg warns before the
# first install). The daemon is on demand: rc service "nix" runs flsocketd on the daemon socket;
# nix-daemon-ondemand starts nix-daemon at the first connection and stops it after 60 s idle.
# Build users nixbld1..nixbld8 (uids 30001-30008) in group nixbld (30000) are made by flpkg.
pkgname=nix
version=2.35.6
release=1
jobs=heavy   # C++23 giant: about 1 GB of RAM per job (see build/config.sh)
summary="The Nix package manager (multi-user, store in /nix, nixpkgs through nix search and profile)"
url=https://nixos.org/
license=(LGPL-2.1-or-later)
arch=(x86_64)
groups=()
depends=(glibc gcc-libs boost blake3 libgit2 libsodium brotli curl sqlite openssl zstd libarchive libseccomp readline ca-certificates)
makedepends=(meson ninja pkgconf bison flex gcc nlohmann_json toml11 boost blake3 libgit2 libsodium brotli curl sqlite openssl zstd libarchive libseccomp readline)
source=(https://github.com/NixOS/nix/archive/refs/tags/2.35.6.tar.gz)
sha256=(0a10c2dadca75797ae7e0bce264230cf818a028d7ac5bbd122984cf3bb82ec59)
worksrc=nix-2.35.6
sysgroups=("nixbld 30000")
sysusers=("nixbld1 30001 30000 /var/empty /usr/bin/false Nix build user 1"
	"nixbld2 30002 30000 /var/empty /usr/bin/false Nix build user 2"
	"nixbld3 30003 30000 /var/empty /usr/bin/false Nix build user 3"
	"nixbld4 30004 30000 /var/empty /usr/bin/false Nix build user 4"
	"nixbld5 30005 30000 /var/empty /usr/bin/false Nix build user 5"
	"nixbld6 30006 30000 /var/empty /usr/bin/false Nix build user 6"
	"nixbld7 30007 30000 /var/empty /usr/bin/false Nix build user 7"
	"nixbld8 30008 30000 /var/empty /usr/bin/false Nix build user 8")
owner=("/nix 0 0 0755" "/nix/store 0 30000 1775" "/nix/var 0 0 0755")

# Meson options: no unit or functional tests (they need gtest, rapidcheck and a full checkout),
# no manual or man pages, no lowdown (markdown), no libcpuid or Boehm GC (both optional).
build() {
	meson setup build --prefix=/usr --buildtype=release \
		-Dsysconfdir=/etc -Dlocalstatedir=/var \
		-Dunit-tests=false -Dfunctional-tests=false -Ddoc-gen=false -Djson-schema-checks=false \
		-Dlibcmd:markdown=disabled -Dlibcmd:readline-flavor=readline \
		-Dlibutil:cpuid=disabled -Dlibexpr:gc=disabled
	# -k 0: keep going past the clang-tidy plugin (a development tool, built only when LLVM is found,
	# and it needs clang headers the system does not ship); everything Nix needs is checked below.
	ninja -C build -k 0 ${NINJAJOBS:+-j$NINJAJOBS} || true
	test -x build/src/nix/nix || { echo "nix: the nix binary was not built" >&2; return 1; }
}

check() { :; }

package() {
	# --no-rebuild: install what build() built (the clang-tidy plugin is left out on purpose)
	# meson's install list still names the plugin: a placeholder lets the install finish, and it is removed again
	: > build/src/clang-tidy-plugin/libnix-clang-tidy.so
	DESTDIR="$pkgdir" meson install -C build --no-rebuild
	find "$pkgdir" -name 'libnix-clang-tidy*' -delete
	# the profile scripts land in /usr/etc (the profile dir is relative to the prefix): they belong in /etc
	if [ -d "$pkgdir/usr/etc" ]; then mkdir -p "$pkgdir/etc" && cp -a "$pkgdir/usr/etc/." "$pkgdir/etc/" && rm -rf "$pkgdir/usr/etc"; fi

	# Store, state and daemon socket directories; the rc service (config/etc/rc.d/init.d/nix)
	# creates the per-user and socket paths at its first start.
	install -d -m 0755 "$pkgdir/nix/var/nix/profiles" "$pkgdir/nix/var/nix/gcroots"
	install -d -m 1775 "$pkgdir/nix/store"

	# On-demand daemon wrapper and the default configuration.
	install -Dm755 "$startdir/nix-daemon-ondemand" "$pkgdir/usr/lib/nix/nix-daemon-ondemand"
	install -Dm644 "$startdir/nix.conf" "$pkgdir/etc/nix/nix.conf"
}
